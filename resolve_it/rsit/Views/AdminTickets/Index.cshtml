@model rsit.ViewModels.Admin.AdminTicketListViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tickets";

    var hasFilters =
        !string.IsNullOrWhiteSpace(Model.Search)
        || !string.IsNullOrWhiteSpace(Model.Status)
        || !string.IsNullOrWhiteSpace(Model.Priority)
        || Model.DepartmentId.HasValue;
}

<div class="page-header">
    <div>
        <h1>Tickets</h1>
        <p>
            Manage and monitor support tickets across the organization.
        </p>
    </div>
</div>


<div class="card-panel">

    <!-- Filters -->
    <form method="get"
          asp-action="Index"
          class="filter-bar">

        <!-- Search -->
        <input type="search"
               name="search"
               value="@Model.Search"
               class="form-control search-box"
               placeholder="Search ticket title or employee" />


        <!-- Status -->
        <select name="status"
                class="form-select">

            <option value="">All statuses</option>

            @foreach (var status in rsit.Models.TicketStatuses.All)
            {
                <option value="@status"
                        selected="@(status == Model.Status)">
                    @status
                </option>
            }

        </select>


        <!-- Priority -->
        <select name="priority"
                class="form-select">

            <option value="">All priorities</option>

            @foreach (var priority in rsit.Models.TicketPriorities.All)
            {
                <option value="@priority"
                        selected="@(priority == Model.Priority)">
                    @priority
                </option>
            }

        </select>


        <!-- Department -->
        <select name="departmentId"
                class="form-select">

            <option value="">All departments</option>

            @foreach (var department in Model.Departments)
            {
                <option value="@department.Value"
                        selected="@(department.Value == Model.DepartmentId?.ToString())">
                    @department.Text
                </option>
            }

        </select>


        <!-- Filter -->
        <button type="submit"
                class="btn btn-teal">

            <i class="bi bi-search me-1"></i>
            Filter

        </button>


        <!-- Clear -->
        @if (hasFilters)
        {
            <a class="btn btn-outline-secondary"
               asp-action="Index">

                Clear

            </a>
        }

    </form>


    <!-- Tickets -->
    @if (Model.Tickets.Count == 0)
    {
        <div class="empty-note">
            No tickets found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover admin-table">

                <thead>

                    <tr>

                        <th>Ticket</th>

                        <th>Employee</th>

                        <th>Department</th>

                        <th>Category</th>

                        <th>Priority</th>

                        <th>Status</th>

                        <th>Assigned staff</th>

                        <th>Created</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>

                            <!-- Ticket -->
                            <td>

                                <div class="fw-semibold">
                                    #@ticket.TicketId
                                </div>

                                <div class="text-muted">
                                    @ticket.Title
                                </div>

                            </td>


                            <!-- Employee -->
                            <td>

                                <div>
                                    @ticket.EmployeeName
                                </div>

                                <code>
                                    @ticket.EmployeeId
                                </code>

                            </td>


                            <!-- Department -->
                            <td>
                                @ticket.DepartmentName
                            </td>


                            <!-- Category -->
                            <td>
                                @ticket.CategoryName
                            </td>


                            <!-- Priority -->
                            <td>

                                @{
                                    var priorityClass = ticket.Priority switch
                                    {
                                        "Low" => "pill-prio-Low",
                                        "Medium" => "pill-prio-Medium",
                                        "High" => "pill-prio-High",
                                        "Critical" => "pill-prio-Critical",
                                        _ => "pill-prio-Low"
                                    };
                                }

                                <span class="pill @priorityClass">
                                    @ticket.Priority
                                </span>

                            </td>


                            <!-- Status -->
                            <td>

                                @{
                                    var statusClass = ticket.Status switch
                                    {
                                        "New" => "pill-New",
                                        "Assigned" => "pill-Assigned",
                                        "In Progress" => "pill-InProgress",
                                        "Resolved" => "pill-Resolved",
                                        "Closed" => "pill-Closed",
                                        "Reopened" => "pill-Reopened",
                                        _ => "pill-inactive"
                                    };
                                }

                                <span class="pill @statusClass">
                                    @ticket.Status
                                </span>

                            </td>


                            <!-- Assigned Staff -->
                            <td>

                                @if (string.IsNullOrWhiteSpace(ticket.AssignedStaffName))
                                {
                                    <span class="text-muted">
                                        Unassigned
                                    </span>
                                }
                                else
                                {
                                    @ticket.AssignedStaffName
                                }

                            </td>


                            <!-- Created -->
                            <td>

                                <div>
                                    @(ticket.CreatedAt.ToDisplayDate())
                                </div>

                                <div class="text-muted small">
                                    @(ticket.CreatedAt.ToDisplayClock())
                                </div>

                            </td>


                            <!-- Actions -->
                            <td>

                                <div class="table-actions">

                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Details"
                                       asp-route-id="@ticket.TicketId">

                                        <i class="bi bi-eye"></i>
                                        View

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>