@model DepartmentListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Departments";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status);
}

<div class="page-header">
    <div>
        <h1>Departments</h1>
        <p>Employees and support staff are assigned to a department when their account is created or edited.</p>
    </div>
    <a class="btn btn-teal" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> Add Department</a>
</div>

<div class="card-panel">

    <form method="get" asp-action="Index" class="filter-bar">
        <input type="search" name="search" value="@Model.Search" class="form-control search-box" placeholder="Search departments" />
        <select name="status" class="form-select">
            <option value="">Any status</option>
            <option value="Active" selected="@(Model.Status == "Active")">Active</option>
            <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
        </select>
        <button type="submit" class="btn btn-teal"><i class="bi bi-search me-1"></i> Filter</button>
        @if (hasFilters)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        }
    </form>

    @if (Model.Departments.Count == 0)
    {
        <div class="empty-note">No departments found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover admin-table">
                <thead>
                    <tr>
                        <th>Name</th><th>Description</th><th class="text-center">Employees</th>
                        <th class="text-center">Support staff</th><th class="text-center">Tickets</th>
                        <th>Status</th><th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Departments)
                    {
                        var active = d.Status == "Active";
                        <tr>
                            <td class="fw-semibold">@d.Name</td>
                            <td class="text-muted">@d.Description</td>
                            <td class="text-center">@d.EmployeeCount</td>
                            <td class="text-center">@d.SupportStaffCount</td>
                            <td class="text-center">@d.TicketCount</td>
                            <td><span class="pill @(active ? "pill-active" : "pill-inactive")">@d.Status</span></td>
                            <td>
                                <div class="table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@d.DepartmentId">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <form asp-action="SetStatus" asp-route-id="@d.DepartmentId" method="post"
                                          onsubmit="return confirm('@(active ? "Deactivate" : "Activate") this department?');">
                                        <input type="hidden" name="activate" value="@((!active).ToString().ToLower())" />
                                        <button type="submit" class="btn btn-sm @(active ? "btn-outline-danger" : "btn-outline-success")">
                                            @(active ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
