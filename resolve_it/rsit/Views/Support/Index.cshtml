@model rsit.ViewModels.Support.SupportDashboardViewModel
@using rsit.Models

@{
    ViewData["Title"] = "Support Dashboard";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">

        <div>
            <div class="text-muted small mb-2">
                Helpdesk / Support
            </div>

            <h1 class="fw-bold mb-2">
                Support Dashboard
            </h1>

            <p class="text-muted mb-0">
                Welcome back, @Model.StaffName.
            </p>
        </div>

        <div class="mt-3 mt-md-0">

            <span class="badge text-bg-light border px-3 py-2">
                <i class="bi bi-person-badge me-1"></i>
                @Model.StaffEmployeeId
            </span>

            <span class="badge text-bg-light border px-3 py-2 ms-2">
                <i class="bi bi-building me-1"></i>
                @Model.DepartmentName
            </span>

        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <!-- Assigned Tickets -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">
                                Assigned Tickets
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.AssignedTickets
                            </h3>
                        </div>

                        <div class="rounded-3 bg-light p-3">
                            <i class="bi bi-ticket-perforated fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- New Tickets -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">
                                New Tickets
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.NewTickets
                            </h3>
                        </div>

                        <div class="rounded-3 bg-light p-3">
                            <i class="bi bi-inbox fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- In Progress -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">
                                In Progress
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.InProgressTickets
                            </h3>
                        </div>

                        <div class="rounded-3 bg-light p-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Resolved -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="text-muted small mb-2">
                                Resolved
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.ResolvedTickets
                            </h3>
                        </div>

                        <div class="rounded-3 bg-light p-3">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Critical Tickets -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <div class="text-muted small mb-1">
                        Critical Tickets
                    </div>

                    <h4 class="fw-bold mb-0">
                        @Model.CriticalTickets
                    </h4>

                </div>

                <div>
                    <i class="bi bi-exclamation-triangle fs-3"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- Assigned Tickets -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        Assigned Tickets
                    </h5>

                    <p class="text-muted mb-0">
                        Tickets currently assigned to you
                    </p>

                </div>

                <span class="badge text-bg-light border">
                    @Model.AssignedTickets Tickets
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.RecentTickets != null && Model.RecentTickets.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Ticket
                                </th>

                                <th>
                                    Request
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Priority
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Created
                                </th>

                                <!-- Added for ticket details -->
                                <th class="text-end pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var ticket in Model.RecentTickets)
                            {
                                <tr>

                                    <!-- Ticket ID -->
                                    <td class="ps-4">

                                        <span class="fw-semibold">
                                            #@ticket.TicketId
                                        </span>

                                    </td>


                                    <!-- Request -->
                                    <td>

                                        <div class="fw-semibold">
                                            @ticket.Title
                                        </div>

                                        <small class="text-muted">
                                            @ticket.EmployeeName
                                        </small>

                                    </td>


                                    <!-- Category -->
                                    <td>

                                        <span class="text-muted">
                                            @ticket.CategoryName
                                        </span>

                                    </td>


                                    <!-- Priority -->
                                    <td>

                                        @if (ticket.Priority == "Critical")
                                        {
                                            <span class="badge text-bg-danger">
                                                @ticket.Priority
                                            </span>
                                        }
                                        else if (ticket.Priority == "High")
                                        {
                                            <span class="badge text-bg-warning">
                                                @ticket.Priority
                                            </span>
                                        }
                                        else if (ticket.Priority == "Medium")
                                        {
                                            <span class="badge text-bg-info">
                                                @ticket.Priority
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                @ticket.Priority
                                            </span>
                                        }

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (ticket.Status == TicketStatuses.Resolved)
                                        {
                                            <span class="badge text-bg-success">
                                                @ticket.Status
                                            </span>
                                        }
                                        else if (ticket.Status == TicketStatuses.InProgress)
                                        {
                                            <span class="badge text-bg-primary">
                                                @ticket.Status
                                            </span>
                                        }
                                        else if (ticket.Status == TicketStatuses.Assigned)
                                        {
                                            <span class="badge text-bg-warning">
                                                @ticket.Status
                                            </span>
                                        }
                                        else if (ticket.Status == TicketStatuses.Closed)
                                        {
                                            <span class="badge text-bg-dark">
                                                @ticket.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                @ticket.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- Created -->
                                    <td>

                                        <span class="text-muted">
                                            @ticket.CreatedAt.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <!-- View Ticket -->
                                    <td class="text-end pe-4">

                                        <a asp-controller="Support"
                                           asp-action="Details"
                                           asp-route-id="@ticket.TicketId"
                                           class="btn btn-sm btn-outline-secondary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-ticket-perforated fs-1 text-muted"></i>
                    </div>

                    <h6 class="fw-semibold">
                        No assigned tickets
                    </h6>

                    <p class="text-muted mb-0">
                        You currently have no tickets assigned to you.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <h5 class="fw-bold mb-1">
                Quick Actions
            </h5>

            <p class="text-muted mb-0">
                Common support tasks
            </p>

        </div>


        <div class="card-body p-4">

            <div class="row g-3">

                <div class="col-12 col-md-4">

                    <button type="button"
                            class="btn btn-outline-secondary w-100 py-3">

                        <i class="bi bi-search me-2"></i>
                        Review Tickets

                    </button>

                </div>


                <div class="col-12 col-md-4">

                    <button type="button"
                            class="btn btn-outline-secondary w-100 py-3">

                        <i class="bi bi-list-check me-2"></i>
                        View Assigned Tickets

                    </button>

                </div>


                <div class="col-12 col-md-4">

                    <button type="button"
                            class="btn btn-outline-secondary w-100 py-3">

                        <i class="bi bi-clock-history me-2"></i>
                        View History

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- Support Workflow -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <h5 class="fw-bold mb-1">
                Support Workflow
            </h5>

            <p class="text-muted mb-0">
                Follow the standard ticket resolution process
            </p>

        </div>


        <div class="card-body p-4">

            <div class="row g-4 text-center">

                <!-- Review -->
                <div class="col-6 col-md-3">

                    <div class="mb-3">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">

                            <i class="bi bi-search fs-4"></i>

                        </div>

                    </div>

                    <h6 class="fw-semibold">
                        Review
                    </h6>

                    <small class="text-muted">
                        Review assigned ticket details
                    </small>

                </div>


                <!-- Investigate -->
                <div class="col-6 col-md-3">

                    <div class="mb-3">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">

                            <i class="bi bi-tools fs-4"></i>

                        </div>

                    </div>

                    <h6 class="fw-semibold">
                        Investigate
                    </h6>

                    <small class="text-muted">
                        Investigate and work on the issue
                    </small>

                </div>


                <!-- Resolve -->
                <div class="col-6 col-md-3">

                    <div class="mb-3">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">

                            <i class="bi bi-check2-circle fs-4"></i>

                        </div>

                    </div>

                    <h6 class="fw-semibold">
                        Resolve
                    </h6>

                    <small class="text-muted">
                        Provide resolution details
                    </small>

                </div>


                <!-- Complete -->
                <div class="col-6 col-md-3">

                    <div class="mb-3">

                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">

                            <i class="bi bi-flag fs-4"></i>

                        </div>

                    </div>

                    <h6 class="fw-semibold">
                        Complete
                    </h6>

                    <small class="text-muted">
                        Complete the support process
                    </small>

                </div>

            </div>

        </div>

    </div>

</div>