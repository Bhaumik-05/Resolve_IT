@model rsit.ViewModels.Support.SupportDashboardViewModel

@{
    ViewData["Title"] = "Support Dashboard";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <div class="text-muted small mb-2">
                Helpdesk / Support
            </div>

            <h1 class="fw-bold mb-2">
                Support Dashboard
            </h1>

            <p class="text-muted mb-0">
                Manage your assigned support requests and track their progress.
            </p>
        </div>

        <div class="text-end d-none d-md-block">
            <span class="badge text-bg-light border px-3 py-2">
                <i class="bi bi-headset me-1"></i>
                Internal IT Helpdesk
            </span>
        </div>

    </div>


    <!-- Staff Information -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-auto">

                    <div class="rounded-3 border bg-light d-flex
                                align-items-center justify-content-center"
                         style="width:52px;height:52px;">

                        <i class="bi bi-person-workspace fs-4 text-secondary"></i>

                    </div>

                </div>


                <div class="col">

                    <div class="text-muted small">
                        Support Staff
                    </div>

                    <div class="fw-semibold fs-5">
                        @Model.StaffName
                    </div>

                </div>


                <div class="col-md-auto mt-3 mt-md-0">

                    <div class="text-muted small">
                        Staff ID
                    </div>

                    <div class="fw-semibold">
                        @Model.StaffEmployeeId
                    </div>

                </div>


                <div class="col-md-auto mt-3 mt-md-0 ms-md-5">

                    <div class="text-muted small">
                        Department
                    </div>

                    <div class="fw-semibold">
                        @Model.DepartmentName
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Statistics -->

    <div class="d-flex align-items-center gap-2 mb-3">

        <div class="bg-dark rounded"
             style="width:4px;height:20px;">
        </div>

        <h5 class="fw-semibold mb-0">
            Workload Overview
        </h5>

        <span class="text-muted small">
            Your current assignments
        </span>

    </div>


    <div class="row g-3 mb-4">

        <!-- Assigned -->

        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small mb-2">
                                Assigned
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.AssignedTickets
                            </div>

                        </div>

                        <div class="text-secondary fs-4">
                            <i class="bi bi-ticket-detailed"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- New -->

        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small mb-2">
                                New
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.NewTickets
                            </div>

                        </div>

                        <div class="text-secondary fs-4">
                            <i class="bi bi-inbox"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- In Progress -->

        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small mb-2">
                                In Progress
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.InProgressTickets
                            </div>

                        </div>

                        <div class="text-secondary fs-4">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Resolved -->

        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small mb-2">
                                Resolved
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.ResolvedTickets
                            </div>

                        </div>

                        <div class="text-secondary fs-4">
                            <i class="bi bi-check2-circle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Critical -->

        <div class="col-xl col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small mb-2">
                                Critical
                            </div>

                            <div class="fs-3 fw-bold">
                                @Model.CriticalTickets
                            </div>

                        </div>

                        <div class="text-secondary fs-4">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Main Content -->

    <div class="row g-4">


        <!-- Assigned Tickets -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-bottom py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h5 class="fw-semibold mb-1">
                                My Assigned Tickets
                            </h5>

                            <div class="text-muted small">
                                Recently assigned support requests
                            </div>

                        </div>

                        <span class="badge text-bg-light border">
                            @Model.AssignedTickets
                        </span>

                    </div>

                </div>


                <div class="card-body p-0">

                    @if (Model.RecentTickets.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th class="ps-4">
                                            Ticket
                                        </th>

                                        <th>
                                            Request
                                        </th>

                                        <th>
                                            Category
                                        </th>

                                        <th>
                                            Priority
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                        <th>
                                            Created
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                @foreach (var ticket in Model.RecentTickets)
                                {
                                    <tr>

                                        <td class="ps-4">

                                            <span class="fw-semibold">
                                                #@ticket.TicketId
                                            </span>

                                        </td>


                                        <td>

                                            <div class="fw-semibold text-truncate"
                                                 style="max-width:220px;">

                                                @ticket.Title

                                            </div>

                                            <div class="text-muted small">

                                                @ticket.EmployeeName

                                            </div>

                                        </td>


                                        <td>

                                            <span class="text-muted small">
                                                @ticket.CategoryName
                                            </span>

                                        </td>


                                        <td>

                                            <span class="badge text-bg-light border">
                                                @ticket.Priority
                                            </span>

                                        </td>


                                        <td>

                                            <span class="badge text-bg-light border">
                                                @ticket.Status
                                            </span>

                                        </td>


                                        <td class="text-muted small">

                                            @ticket.CreatedAt.ToString("dd MMM yyyy")

                                        </td>

                                    </tr>
                                }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="bi bi-inbox fs-1 text-muted"></i>

                            <h6 class="mt-3">
                                No tickets assigned
                            </h6>

                            <p class="text-muted small mb-0">
                                New assignments will appear here.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- Sidebar -->

        <div class="col-lg-4">


            <!-- Quick Actions -->

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-semibold mb-0">
                        Quick Actions
                    </h5>

                </div>


                <div class="card-body">

                    <div class="d-grid gap-2">

                        <button type="button"
                                class="btn btn-outline-secondary text-start">

                            <i class="bi bi-ticket-detailed me-2"></i>

                            View Assigned Tickets

                        </button>


                        <button type="button"
                                class="btn btn-outline-secondary text-start">

                            <i class="bi bi-clock-history me-2"></i>

                            View Recent Activity

                        </button>

                    </div>

                </div>

            </div>


            <!-- Workflow -->

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h5 class="fw-semibold mb-1">
                        Resolution Workflow
                    </h5>

                    <div class="text-muted small">
                        Support process
                    </div>

                </div>


                <div class="card-body">

                    <div class="d-flex gap-3 mb-4">

                        <div class="fw-bold text-muted">
                            01
                        </div>

                        <div>

                            <div class="fw-semibold small">
                                Review
                            </div>

                            <div class="text-muted small">
                                Understand the reported issue.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex gap-3 mb-4">

                        <div class="fw-bold text-muted">
                            02
                        </div>

                        <div>

                            <div class="fw-semibold small">
                                Investigate
                            </div>

                            <div class="text-muted small">
                                Diagnose the underlying problem.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex gap-3 mb-4">

                        <div class="fw-bold text-muted">
                            03
                        </div>

                        <div>

                            <div class="fw-semibold small">
                                Resolve
                            </div>

                            <div class="text-muted small">
                                Add resolution remarks.
                            </div>

                        </div>

                    </div>


                    <div class="d-flex gap-3">

                        <div class="fw-bold text-muted">
                            04
                        </div>

                        <div>

                            <div class="fw-semibold small">
                                Complete
                            </div>

                            <div class="text-muted small">
                                Employee confirms closure.
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>