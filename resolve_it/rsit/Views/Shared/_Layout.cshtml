<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ResolveIT</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/rsit.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Navbar.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <!-- ============================================================
         RESOLVEIT NAVBAR
         ============================================================ -->

    <header>

        <nav class="rit-navbar">

            <div class="rit-navbar-container">

                <!-- =================================================
                     BRAND
                     ================================================= -->

                <a class="rit-navbar-brand"
                   asp-controller="Employee"
                   asp-action="Index">

                    <span class="rit-brand-mark">
                        <i class="bi bi-shield-check"></i>
                    </span>

                    <span class="rit-brand-text">
                        ResolveIT
                    </span>

                </a>


                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- =================================================
                         NAVIGATION
                         ================================================= -->

                    <div class="rit-navbar-links">

                        @if (User.IsInRole("Employee"))
                        {
                            <a asp-controller="Employee"
                               asp-action="Index"
                               class="rit-nav-link">

                                <i class="bi bi-grid-1x2"></i>

                                <span>
                                    Dashboard
                                </span>

                            </a>


                            <a asp-controller="Tickets"
                               asp-action="Create"
                               class="rit-nav-link">

                                <i class="bi bi-plus-square"></i>

                                <span>
                                    Create Ticket
                                </span>

                            </a>


                            <a asp-controller="Tickets"
                               asp-action="Index"
                               class="rit-nav-link">

                                <i class="bi bi-ticket-perforated"></i>

                                <span>
                                    My Tickets
                                </span>

                            </a>
                        }


                        @if (User.IsInRole("SupportStaff"))
                        {
                            <a asp-controller="Support"
                               asp-action="Index"
                               class="rit-nav-link">

                                <i class="bi bi-grid-1x2"></i>

                                <span>
                                    Dashboard
                                </span>

                            </a>
                        }


                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin"
                               asp-action="Dashboard"
                               class="rit-nav-link">

                                <i class="bi bi-grid-1x2"></i>

                                <span>
                                    Dashboard
                                </span>

                            </a>
                        }

                    </div>


                    <!-- =================================================
                         USER AREA
                         ================================================= -->

                    <div class="rit-navbar-user">

                        <div class="rit-user-info">

                            <div class="rit-user-icon">
                                <i class="bi bi-person"></i>
                            </div>

                            <div class="rit-user-details">

                                <strong>
                                    @User.Identity.Name
                                </strong>

                                <span>

                                    @if (User.IsInRole("Employee"))
                                    {
                                        <text>Employee</text>
                                    }
                                    else if (User.IsInRole("SupportStaff"))
                                    {
                                        <text>Support Staff</text>
                                    }
                                    else if (User.IsInRole("Admin"))
                                    {
                                        <text>Administrator</text>
                                    }

                                </span>

                            </div>

                        </div>


                        <div class="rit-navbar-divider"></div>


                        <!-- Logout -->

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="rit-logout-form">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="rit-logout-button">

                                <i class="bi bi-box-arrow-right"></i>

                                <span>
                                    Logout
                                </span>

                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <!-- =================================================
                         LOGIN
                         ================================================= -->

                    <div class="rit-navbar-user">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="rit-login-button">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Login

                        </a>

                    </div>
                }

            </div>

        </nav>

    </header>


    <!-- ============================================================
         PAGE CONTENT
         ============================================================ -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ============================================================
         FOOTER
         ============================================================ -->

    <footer class="rit-footer">

        <div class="rit-footer-container">

            <span>
                © 2026 ResolveIT
            </span>

            <span>
                Internal IT Helpdesk
            </span>

        </div>

    </footer>


    <!-- ============================================================
         SCRIPTS
         ============================================================ -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>