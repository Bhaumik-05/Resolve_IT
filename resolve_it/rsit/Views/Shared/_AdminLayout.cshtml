@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ResolveIT Admin</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">

    <div class="admin-shell">

        <aside class="admin-sidebar">

            <a class="admin-brand" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-headset"></i>
                <span>ResolveIT</span>
            </a>

            <nav class="admin-nav">
                <div class="admin-nav-label">Overview</div>
                <a class="@Active("Admin")" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="admin-nav-label">Management</div>
                <a class="@Active("Users")" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> Users
                </a>
                <a class="@Active("Departments")" asp-controller="Departments" asp-action="Index">
                    <i class="bi bi-diagram-3"></i> Departments
                </a>
                <a class="@Active("Categories")" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-tags"></i> Categories
                </a>
            </nav>

            <div class="admin-user">
                <span>Signed in as</span>
                <strong>@User.Identity?.Name</strong>

                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit"><i class="bi bi-box-arrow-right me-1"></i> Logout</button>
                </form>
            </div>

        </aside>

        <main class="admin-main">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
