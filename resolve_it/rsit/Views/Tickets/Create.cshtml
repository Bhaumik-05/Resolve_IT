@model rsit.ViewModels.CreateTicketViewModel

@{
    ViewData["Title"] = "Create Ticket";
}

<style>
    /* =========================================================
       ResolveIT - Enterprise IT Service Desk
       ========================================================= */

    :root {
        --rit-navy: #14213d;
        --rit-navy-light: #1d3158;

        --rit-blue: #2563eb;
        --rit-blue-dark: #1d4ed8;
        --rit-blue-soft: #eff6ff;
        --rit-blue-border: #bfdbfe;

        --rit-bg: #f3f6fa;
        --rit-surface: #ffffff;

        --rit-text: #172033;
        --rit-text-secondary: #475467;
        --rit-muted: #667085;
        --rit-placeholder: #98a2b3;

        --rit-border: #dfe4ea;
        --rit-border-light: #eaecf0;

        --rit-success: #027a48;
        --rit-success-soft: #ecfdf3;

        --rit-warning: #b54708;
        --rit-warning-soft: #fffaeb;

        --rit-danger: #b42318;
        --rit-danger-soft: #fef3f2;

        --rit-radius: 10px;
    }


    /* =========================================================
       PAGE
       ========================================================= */

    .rit-ticket-page {
        min-height: calc(100vh - 120px);
        background:
            linear-gradient(
                180deg,
                #eef3f9 0,
                #f5f7fa 210px,
                #f5f7fa 100%
            );

        padding: 30px 0 55px;
    }

    .rit-container {
        max-width: 1180px;
        margin: 0 auto;
    }


    /* =========================================================
       TOP BAR / BREADCRUMB
       ========================================================= */

    .rit-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;

        margin-bottom: 13px;

        color: var(--rit-muted);
        font-size: 12px;
        font-weight: 500;
    }

    .rit-breadcrumb i {
        font-size: 10px;
        color: #98a2b3;
    }

    .rit-breadcrumb .active {
        color: var(--rit-blue);
        font-weight: 600;
    }


    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .rit-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;

        gap: 25px;
        margin-bottom: 25px;
    }

    .rit-page-title {
        margin: 0;

        color: var(--rit-navy);

        font-size: 29px;
        line-height: 1.25;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .rit-page-subtitle {
        margin: 7px 0 0;

        max-width: 720px;

        color: var(--rit-muted);

        font-size: 13.5px;
        line-height: 1.6;
    }

    .rit-page-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 8px 12px;

        border: 1px solid var(--rit-blue-border);
        border-radius: 7px;

        background: var(--rit-blue-soft);
        color: var(--rit-blue-dark);

        font-size: 12px;
        font-weight: 600;

        white-space: nowrap;
    }

    .rit-page-badge i {
        font-size: 13px;
    }


    /* =========================================================
       MAIN GRID
       ========================================================= */

    .rit-main-grid {
        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            300px;

        gap: 22px;

        align-items: start;
    }


    /* =========================================================
       FORM CARD
       ========================================================= */

    .rit-form-card {
        overflow: hidden;

        background: var(--rit-surface);

        border: 1px solid var(--rit-border);
        border-radius: var(--rit-radius);

        box-shadow:
            0 1px 2px rgba(16, 24, 40, 0.04),
            0 4px 12px rgba(16, 24, 40, 0.035);
    }


    /* =========================================================
       FORM HEADER
       ========================================================= */

    .rit-form-header {
        display: flex;
        align-items: center;

        gap: 13px;

        padding: 20px 25px;

        background: #ffffff;

        border-bottom: 1px solid var(--rit-border-light);
    }

    .rit-form-header-icon {
        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: var(--rit-blue-soft);
        color: var(--rit-blue);

        font-size: 18px;
    }

    .rit-form-header h2 {
        margin: 0;

        color: var(--rit-navy);

        font-size: 16px;
        font-weight: 650;
    }

    .rit-form-header p {
        margin: 3px 0 0;

        color: var(--rit-muted);

        font-size: 12px;
    }


    /* =========================================================
       FORM BODY
       ========================================================= */

    .rit-form-body {
        padding: 27px 25px;
    }


    /* =========================================================
       SECTION TITLE
       ========================================================= */

    .rit-section {
        margin-bottom: 28px;
    }

    .rit-section:last-child {
        margin-bottom: 0;
    }

    .rit-section-heading {
        display: flex;
        align-items: center;

        gap: 10px;

        margin-bottom: 17px;
    }

    .rit-section-line {
        width: 3px;
        height: 19px;

        border-radius: 3px;

        background: var(--rit-blue);
    }

    .rit-section-heading h3 {
        margin: 0;

        color: var(--rit-navy);

        font-size: 14px;
        font-weight: 650;
    }

    .rit-section-heading span {
        margin-left: auto;

        color: var(--rit-muted);

        font-size: 11px;
    }


    /* =========================================================
       FORM FIELDS
       ========================================================= */

    .rit-field {
        margin-bottom: 18px;
    }

    .rit-field:last-child {
        margin-bottom: 0;
    }

    .rit-label {
        display: block;

        margin-bottom: 7px;

        color: #344054;

        font-size: 12.5px;
        font-weight: 650;
    }

    .rit-required {
        color: var(--rit-danger);
        margin-left: 2px;
    }

    .rit-input,
    .rit-select,
    .rit-textarea {
        width: 100%;

        border: 1px solid #cfd5dd;
        border-radius: 7px;

        background: #ffffff;

        color: var(--rit-text);

        font-family: inherit;
        font-size: 13px;

        transition:
            border-color .15s ease,
            box-shadow .15s ease,
            background-color .15s ease;
    }

    .rit-input,
    .rit-select {
        height: 43px;

        padding: 0 12px;
    }

    .rit-textarea {
        min-height: 145px;

        padding: 11px 12px;

        resize: vertical;

        line-height: 1.55;
    }

    .rit-input::placeholder,
    .rit-textarea::placeholder {
        color: var(--rit-placeholder);
    }

    .rit-input:hover,
    .rit-select:hover,
    .rit-textarea:hover {
        border-color: #aeb7c4;
    }

    .rit-input:focus,
    .rit-select:focus,
    .rit-textarea:focus {
        outline: none;

        border-color: #6f9bf7;

        box-shadow:
            0 0 0 3px rgba(37, 99, 235, .09);
    }

    .rit-help {
        margin-top: 6px;

        color: #8a94a4;

        font-size: 11px;
        line-height: 1.5;
    }

    .rit-validation {
        display: block;

        margin-top: 5px;

        color: var(--rit-danger);

        font-size: 11px;
    }


    /* =========================================================
       TWO COLUMN FIELDS
       ========================================================= */

    .rit-field-grid {
        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 17px;
    }


    /* =========================================================
       PRIORITY SELECT
       ========================================================= */

    .rit-priority-wrapper {
        position: relative;
    }

    .rit-priority-wrapper::before {
        content: "";

        position: absolute;

        left: 12px;
        top: 50%;

        width: 7px;
        height: 7px;

        border-radius: 50%;

        background: #94a3b8;

        transform: translateY(-50%);

        pointer-events: none;
    }

    .rit-priority-select {
        padding-left: 28px;
    }


    /* =========================================================
       ATTACHMENT AREA
       ========================================================= */

    .rit-upload-area {
        padding: 19px;

        border: 1px dashed #aeb8c6;
        border-radius: 9px;

        background:
            linear-gradient(
                135deg,
                #f8fbff 0%,
                #fbfcfe 100%
            );

        transition:
            border-color .15s ease,
            background-color .15s ease;
    }

    .rit-upload-area:hover {
        border-color: #7aa2f7;
        background: #f6f9ff;
    }

    .rit-upload-top {
        display: flex;
        align-items: flex-start;

        gap: 13px;

        margin-bottom: 14px;
    }

    .rit-upload-icon {
        width: 42px;
        height: 42px;

        flex: 0 0 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: #e8f0ff;
        color: var(--rit-blue);

        font-size: 18px;
    }

    .rit-upload-title {
        margin: 0 0 3px;

        color: var(--rit-text);

        font-size: 13px;
        font-weight: 650;
    }

    .rit-upload-description {
        margin: 0;

        color: var(--rit-muted);

        font-size: 11.5px;
        line-height: 1.55;
    }

    .rit-file-input {
        width: 100%;

        padding: 7px;

        border: 1px solid var(--rit-border);
        border-radius: 6px;

        background: #ffffff;

        color: var(--rit-muted);

        font-size: 12px;
    }

    .rit-file-input:focus {
        outline: none;

        border-color: #7aa2f7;

        box-shadow:
            0 0 0 3px rgba(37, 99, 235, .08);
    }


    /* =========================================================
       FORM ACTIONS
       ========================================================= */

    .rit-form-actions {
        display: flex;

        justify-content: flex-end;
        align-items: center;

        gap: 9px;

        padding-top: 22px;

        border-top: 1px solid var(--rit-border-light);
    }

    .rit-btn {
        min-height: 40px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        padding: 0 17px;

        border-radius: 7px;

        font-size: 12.5px;
        font-weight: 600;

        text-decoration: none;

        cursor: pointer;

        transition:
            background-color .15s ease,
            border-color .15s ease,
            transform .1s ease;
    }

    .rit-btn:active {
        transform: translateY(1px);
    }

    .rit-btn-cancel {
        border: 1px solid #cfd5dd;

        background: #ffffff;

        color: #344054;
    }

    .rit-btn-cancel:hover {
        background: #f8fafc;
        color: #1f2937;
    }

    .rit-btn-submit {
        border: 1px solid var(--rit-blue);

        background: var(--rit-blue);

        color: #ffffff;
    }

    .rit-btn-submit:hover {
        border-color: var(--rit-blue-dark);
        background: var(--rit-blue-dark);

        color: #ffffff;
    }


    /* =========================================================
       RIGHT SIDEBAR
       ========================================================= */

    .rit-sidebar {
        display: flex;

        flex-direction: column;

        gap: 15px;
    }


    /* =========================================================
       SIDEBAR CARD
       ========================================================= */

    .rit-side-card {
        overflow: hidden;

        background: #ffffff;

        border: 1px solid var(--rit-border);
        border-radius: var(--rit-radius);

        box-shadow:
            0 1px 2px rgba(16, 24, 40, .03);
    }

    .rit-side-header {
        padding: 16px 17px;

        border-bottom: 1px solid var(--rit-border-light);
    }

    .rit-side-header h3 {
        margin: 0;

        color: var(--rit-navy);

        font-size: 13.5px;
        font-weight: 650;
    }

    .rit-side-body {
        padding: 17px;
    }


    /* =========================================================
       WORKFLOW
       ========================================================= */

    .rit-workflow {
        position: relative;

        padding-left: 4px;
    }

    .rit-workflow-item {
        position: relative;

        display: flex;

        gap: 11px;

        padding-bottom: 20px;
    }

    .rit-workflow-item:last-child {
        padding-bottom: 0;
    }

    .rit-workflow-item:not(:last-child)::before {
        content: "";

        position: absolute;

        left: 10px;
        top: 23px;

        width: 1px;
        height: calc(100% - 13px);

        background: #dce2ea;
    }

    .rit-step-number {
        position: relative;
        z-index: 1;

        width: 21px;
        height: 21px;

        flex: 0 0 21px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #d5dbe4;
        border-radius: 50%;

        background: #ffffff;

        color: #667085;

        font-size: 10px;
        font-weight: 700;
    }

    .rit-workflow-item:first-child .rit-step-number {
        border-color: #93b4fb;

        background: var(--rit-blue-soft);

        color: var(--rit-blue);
    }

    .rit-step-content strong {
        display: block;

        margin-bottom: 2px;

        color: #344054;

        font-size: 11.5px;
        font-weight: 650;
    }

    .rit-step-content span {
        display: block;

        color: var(--rit-muted);

        font-size: 10.8px;
        line-height: 1.45;
    }


    /* =========================================================
       PRIORITY GUIDE
       ========================================================= */

    .rit-priority-guide {
        display: flex;

        flex-direction: column;

        gap: 9px;
    }

    .rit-priority-item {
        display: flex;

        align-items: center;

        gap: 9px;
    }

    .rit-priority-dot {
        width: 8px;
        height: 8px;

        border-radius: 50%;
    }

    .priority-low {
        background: #16a34a;
    }

    .priority-medium {
        background: #eab308;
    }

    .priority-high {
        background: #f97316;
    }

    .priority-critical {
        background: #dc2626;
    }

    .rit-priority-item span {
        color: #667085;

        font-size: 11.5px;
    }

    .rit-priority-item strong {
        margin-left: auto;

        color: #344054;

        font-size: 11px;
        font-weight: 600;
    }


    /* =========================================================
       INFORMATION NOTICE
       ========================================================= */

    .rit-info-box {
        padding: 14px;

        border: 1px solid #cfe0ff;
        border-radius: 8px;

        background: #f5f9ff;
    }

    .rit-info-box-top {
        display: flex;

        gap: 9px;

        margin-bottom: 7px;
    }

    .rit-info-box-icon {
        color: var(--rit-blue);

        font-size: 14px;
    }

    .rit-info-box strong {
        color: #24406e;

        font-size: 11.5px;
        font-weight: 650;
    }

    .rit-info-box p {
        margin: 0;

        color: #5c6f8d;

        font-size: 10.8px;
        line-height: 1.55;
    }


    /* =========================================================
       VALIDATION
       ========================================================= */

    .rit-validation-summary {
        padding: 12px 14px;

        border: 1px solid #fecdca;
        border-radius: 7px;

        background: var(--rit-danger-soft);

        color: var(--rit-danger);

        font-size: 12px;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 950px) {

        .rit-main-grid {
            grid-template-columns: 1fr;
        }

        .rit-sidebar {
            display: grid;

            grid-template-columns: 1fr 1fr;
        }

        .rit-info-box {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 700px) {

        .rit-ticket-page {
            padding: 22px 0 35px;
        }

        .rit-page-header {
            align-items: flex-start;

            flex-direction: column;
        }

        .rit-page-badge {
            display: none;
        }

        .rit-page-title {
            font-size: 24px;
        }

        .rit-field-grid {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .rit-form-body {
            padding: 21px 18px;
        }

        .rit-form-header {
            padding: 18px;
        }

        .rit-sidebar {
            grid-template-columns: 1fr;
        }

        .rit-form-actions {
            flex-direction: column-reverse;

            align-items: stretch;
        }

        .rit-btn {
            width: 100%;
        }
    }
</style>


<div class="rit-ticket-page">

    <div class="container rit-container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="rit-breadcrumb">

            <span>Helpdesk</span>

            <i class="bi bi-chevron-right"></i>

            <span class="active">
                Create Ticket
            </span>

        </div>


        <div class="rit-page-header">

            <div>

                <h1 class="rit-page-title">
                    Create Support Ticket
                </h1>

                <p class="rit-page-subtitle">
                    Report an IT issue to the support team. Provide clear
                    information so your request can be reviewed and resolved efficiently.
                </p>

            </div>

            <div class="rit-page-badge">
                <i class="bi bi-shield-check"></i>
                Internal IT Helpdesk
            </div>

        </div>


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <div class="rit-main-grid">


            <!-- =================================================
                 FORM
                 ================================================= -->

            <div class="rit-form-card">


                <!-- Form Header -->

                <div class="rit-form-header">

                    <div class="rit-form-header-icon">
                        <i class="bi bi-ticket-detailed"></i>
                    </div>

                    <div>

                        <h2>
                            Issue information
                        </h2>

                        <p>
                            Provide the details required to process your request.
                        </p>

                    </div>

                </div>


                <!-- Form Body -->

                <div class="rit-form-body">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()


                        <!-- Validation -->

                        <div asp-validation-summary="ModelOnly"
                             class="rit-validation-summary mb-4">
                        </div>


                        <!-- =================================================
                             SECTION 01 — BASIC INFORMATION
                             ================================================= -->

                        <div class="rit-section">

                            <div class="rit-section-heading">

                                <div class="rit-section-line"></div>

                                <h3>
                                    Basic information
                                </h3>

                                <span>
                                    Required fields marked *
                                </span>

                            </div>


                            <!-- Title -->

                            <div class="rit-field">

                                <label asp-for="Title"
                                       class="rit-label">

                                    Issue title

                                    <span class="rit-required">
                                        *
                                    </span>

                                </label>

                                <input asp-for="Title"
                                       class="rit-input"
                                       placeholder="Example: Unable to connect to office Wi-Fi" />

                                <div class="rit-help">
                                    Keep the title short and specific.
                                </div>

                                <span asp-validation-for="Title"
                                      class="rit-validation">
                                </span>

                            </div>


                            <!-- Description -->

                            <div class="rit-field">

                                <label asp-for="Description"
                                       class="rit-label">

                                    Description

                                    <span class="rit-required">
                                        *
                                    </span>

                                </label>

                                <textarea asp-for="Description"
                                          class="rit-textarea"
                                          placeholder="Describe the problem, when it started, and any error message or unusual behaviour you observed..."></textarea>

                                <div class="rit-help">
                                    Include affected systems, error messages,
                                    steps to reproduce the problem, and other useful details.
                                </div>

                                <span asp-validation-for="Description"
                                      class="rit-validation">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             SECTION 02 — CLASSIFICATION
                             ================================================= -->

                        <div class="rit-section">

                            <div class="rit-section-heading">

                                <div class="rit-section-line"></div>

                                <h3>
                                    Classification
                                </h3>

                                <span>
                                    Used for routing
                                </span>

                            </div>


                            <div class="rit-field-grid">


                                <!-- Priority -->

                                <div class="rit-field">

                                    <label asp-for="Priority"
                                           class="rit-label">

                                        Priority

                                        <span class="rit-required">
                                            *
                                        </span>

                                    </label>

                                    <div class="rit-priority-wrapper">

                                        <select asp-for="Priority"
                                                class="rit-select rit-priority-select">

                                            <option value="">
                                                Select priority
                                            </option>

                                            @foreach (var priority in Model.Priorities)
                                            {
                                                <option value="@priority">
                                                    @priority
                                                </option>
                                            }

                                        </select>

                                    </div>

                                    <div class="rit-help">
                                        Select according to business impact and urgency.
                                    </div>

                                    <span asp-validation-for="Priority"
                                          class="rit-validation">
                                    </span>

                                </div>


                                <!-- Category -->

                                <div class="rit-field">

                                    <label asp-for="CategoryId"
                                           class="rit-label">

                                        Category

                                        <span class="rit-required">
                                            *
                                        </span>

                                    </label>

                                    <select asp-for="CategoryId"
                                            class="rit-select">

                                        <option value="">
                                            Select category
                                        </option>

                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.CategoryId">
                                                @category.Name
                                            </option>
                                        }

                                    </select>

                                    <div class="rit-help">
                                        Choose the category that best matches the issue.
                                    </div>

                                    <span asp-validation-for="CategoryId"
                                          class="rit-validation">
                                    </span>

                                </div>

                            </div>


                            <!-- Department -->

                            <div class="rit-field">

                                <label asp-for="DepartmentId"
                                       class="rit-label">

                                    Department

                                    <span class="rit-required">
                                        *
                                    </span>

                                </label>

                                <select asp-for="DepartmentId"
                                        class="rit-select">

                                    <option value="">
                                        Select responsible department
                                    </option>

                                    @foreach (var department in Model.Departments)
                                    {
                                        <option value="@department.DepartmentId">
                                            @department.Name
                                        </option>
                                    }

                                </select>

                                <div class="rit-help">
                                    The selected department will be associated
                                    with this support request.
                                </div>

                                <span asp-validation-for="DepartmentId"
                                      class="rit-validation">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             SECTION 03 — ATTACHMENTS
                             ================================================= -->

                        <div class="rit-section">

                            <div class="rit-section-heading">

                                <div class="rit-section-line"></div>

                                <h3>
                                    Supporting files
                                </h3>

                                <span>
                                    Optional
                                </span>

                            </div>


                            <div class="rit-upload-area">

                                <div class="rit-upload-top">

                                    <div class="rit-upload-icon">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                    </div>

                                    <div>

                                        <p class="rit-upload-title">
                                            Attach supporting files
                                        </p>

                                        <p class="rit-upload-description">
                                            Add screenshots, error reports,
                                            documents, or other files that can
                                            help the support team diagnose the issue.
                                        </p>

                                    </div>

                                </div>


                                <input asp-for="Attachments"
                                       type="file"
                                       class="rit-file-input"
                                       multiple />


                                <div class="rit-help">
                                    Multiple files can be selected.
                                    Only attach files relevant to this ticket.
                                </div>

                                <span asp-validation-for="Attachments"
                                      class="rit-validation">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
