@model rsit.ViewModels.CreateTicketViewModel

@{
    ViewData["Title"] = "Create Ticket";
}

<link rel="stylesheet" href="~/css/CreateTicket.css" asp-append-version="true" />

<div class="rit-ticket-page">

    <div class="container rit-container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="rit-breadcrumb">
            <span>Helpdesk</span>
            <i class="bi bi-chevron-right"></i>
            <span class="active">Create Ticket</span>
        </div>

        <div class="rit-page-header">

            <div>
                <h1 class="rit-page-title">
                    Create Support Ticket
                </h1>

                <p class="rit-page-subtitle">
                    Report an IT issue to the support team. Provide clear
                    information so your request can be reviewed and resolved efficiently.
                </p>
            </div>

            <div class="rit-page-badge">
                <i class="bi bi-shield-check"></i>
                Internal IT Helpdesk
            </div>

        </div>


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <div class="rit-main-grid">

            <!-- =================================================
                 FORM
                 ================================================= -->

            <div class="rit-form-card">

                <!-- Form Header -->

                <div class="rit-form-header">

                    <div class="rit-form-header-icon">
                        <i class="bi bi-ticket-detailed"></i>
                    </div>

                    <div>
                        <h2>
                            Issue information
                        </h2>

                        <p>
                            Provide the details required to process your request.
                        </p>
                    </div>

                </div>


                <!-- Form Body -->

                <div class="rit-form-body">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data"
                          id="createTicketForm">

                        @Html.AntiForgeryToken()


                        <!-- =================================================
                             VALIDATION SUMMARY
                             ================================================= -->

                        <div asp-validation-summary="ModelOnly"
                             class="rit-validation-summary mb-4">
                        </div>


                        <!-- =================================================
                             SECTION 01 — BASIC INFORMATION
                             ================================================= -->

                        <div class="rit-section">

                            <div class="rit-section-heading">

                                <div class="rit-section-line"></div>

                                <h3>
                                    Basic information
                                </h3>

                                <span>
                                    Required fields marked *
                                </span>

                            </div>


                            <!-- Title -->

                            <div class="rit-field">

                                <label asp-for="Title"
                                       class="rit-label">

                                    Issue title

                                    <span class="rit-required">
                                        *
                                    </span>

                                </label>

                                <input asp-for="Title"
                                       class="rit-input"
                                       placeholder="Example: Unable to connect to office Wi-Fi" />

                                <div class="rit-help">
                                    Keep the title short and specific.
                                </div>

                                <span asp-validation-for="Title"
                                      class="rit-validation">
                                </span>

                            </div>


                            <!-- Description -->

                            <div class="rit-field">

                                <label asp-for="Description"
                                       class="rit-label">

                                    Description

                                    <span class="rit-required">
                                        *
                                    </span>

                                </label>

                                <textarea asp-for="Description"
                                          class="rit-textarea"
                                          placeholder="Describe the problem, when it started, and any error message or unusual behaviour you observed..."></textarea>

                                <div class="rit-help">
                                    Include affected systems, error messages,
                                    steps to reproduce the problem, and other useful details.
                                </div>

                                <span asp-validation-for="Description"
                                      class="rit-validation">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             SECTION 02 — CLASSIFICATION
                             ================================================= -->

                        <div class="rit-section">

                            <div class="rit-section-heading">

                                <div class="rit-section-line"></div>

                                <h3>
                                    Classification
                                </h3>

                                <span>
                                    Used for routing
                                </span>

                            </div>


                            <div class="rit-field-grid">

                                <!-- Priority -->

                                <div class="rit-field">

                                    <label asp-for="Priority"
                                           class="rit-label">

                                        Priority

                                        <span class="rit-required">
                                            *
                                        </span>

                                    </label>

                                    <div class="rit-priority-wrapper">

                                        <select asp-for="Priority"
                                                class="rit-select rit-priority-select">

                                            <option value="">
                                                Select priority
                                            </option>

                                            @foreach (var priority in Model.Priorities)
                                            {
                                                <option value="@priority">
                                                    @priority
                                                </option>
                                            }

                                        </select>

                                    </div>

                                    <div class="rit-help">
                                        Select according to business impact and urgency.
                                    </div>

                                    <span asp-validation-for="Priority"
                                          class="rit-validation">
                                    </span>

                                </div>


                                <!-- Category -->

                                <div class="rit-field">

                                    <label asp-for="CategoryId"
                                           class="rit-label">

                                        Category

                                        <span class="rit-required">
                                            *
                                        </span>

                                    </label>

                                    <select asp-for="CategoryId"
                                            class="rit-select">

                                        <option value="">
                                            Select category
                                        </option>

                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.CategoryId">
                                                @category.Name
                                            </option>
                                        }

                                    </select>

                                    <div class="rit-help">
                                        Choose the category that best matches the issue.
                                    </div>

                                    <span asp-validation-for="CategoryId"
                                          class="rit-validation">
                                    </span>

                                </div>

                            </div>


                            <!-- Department -->

                            <div class="rit-field">

                                <label asp-for="DepartmentId"
                                       class="rit-label">

                                    Department

                                    <span class="rit-required">
                                        *
                                    </span>

                                </label>

                                <select asp-for="DepartmentId"
                                        class="rit-select">

                                    <option value="">
                                        Select responsible department
                                    </option>

                                    @foreach (var department in Model.Departments)
                                    {
                                        <option value="@department.DepartmentId">
                                            @department.Name
                                        </option>
                                    }

                                </select>

                                <div class="rit-help">
                                    The selected department will be associated
                                    with this support request.
                                </div>

                                <span asp-validation-for="DepartmentId"
                                      class="rit-validation">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             SECTION 03 — ATTACHMENTS
                             ================================================= -->

                        <div class="rit-section">

                            <div class="rit-section-heading">

                                <div class="rit-section-line"></div>

                                <h3>
                                    Supporting files
                                </h3>

                                <span>
                                    Optional
                                </span>

                            </div>


                            <div class="rit-upload-area">

                                <div class="rit-upload-top">

                                    <div class="rit-upload-icon">
                                        <i class="bi bi-cloud-arrow-up"></i>
                                    </div>

                                    <div>

                                        <p class="rit-upload-title">
                                            Attach supporting files
                                        </p>

                                        <p class="rit-upload-description">
                                            Add screenshots, error reports,
                                            documents, or other files that can
                                            help the support team diagnose the issue.
                                        </p>

                                    </div>

                                </div>


                                <input asp-for="Attachments"
                                       type="file"
                                       class="rit-file-input"
                                       multiple />

                                <div class="rit-help">
                                    Multiple files can be selected.
                                    Only attach files relevant to this ticket.
                                </div>

                                <span asp-validation-for="Attachments"
                                      class="rit-validation">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             ACTIONS
                             ================================================= -->

                        <div class="rit-form-actions">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="rit-btn rit-btn-cancel">

                                <i class="bi bi-x-lg"></i>

                                Cancel

                            </a>


                            <button type="submit"
                                    class="rit-btn rit-btn-submit">

                                <i class="bi bi-send"></i>

                                Submit Ticket

                            </button>

                        </div>

                    </form>

                </div>

            </div>


            <!-- =================================================
                 SIDEBAR
                 ================================================= -->

            <aside class="rit-sidebar">


                <!-- =================================================
                     WORKFLOW CARD
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Ticket workflow
                        </h3>

                    </div>


                    <div class="rit-side-body">

                        <div class="rit-workflow">


                            <div class="rit-workflow-item">

                                <div class="rit-step-number">
                                    1
                                </div>

                                <div class="rit-step-content">

                                    <strong>
                                        Submit request
                                    </strong>

                                    <span>
                                        Your issue is registered with a unique ticket number.
                                    </span>

                                </div>

                            </div>


                            <div class="rit-workflow-item">

                                <div class="rit-step-number">
                                    2
                                </div>

                                <div class="rit-step-content">

                                    <strong>
                                        Review & assignment
                                    </strong>

                                    <span>
                                        The support team reviews and assigns the request.
                                    </span>

                                </div>

                            </div>


                            <div class="rit-workflow-item">

                                <div class="rit-step-number">
                                    3
                                </div>

                                <div class="rit-step-content">

                                    <strong>
                                        Investigation
                                    </strong>

                                    <span>
                                        Support staff investigate and work on the issue.
                                    </span>

                                </div>

                            </div>


                            <div class="rit-workflow-item">

                                <div class="rit-step-number">
                                    4
                                </div>

                                <div class="rit-step-content">

                                    <strong>
                                        Resolution
                                    </strong>

                                    <span>
                                        The ticket is resolved and can be closed.
                                    </span>

                                </div>

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     PRIORITY CARD
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Priority guide
                        </h3>

                    </div>

                    <div class="rit-side-body">

                        <div class="rit-priority-guide">


                            <div class="rit-priority-item">

                                <div class="rit-priority-dot priority-low"></div>

                                <span>
                                    Low impact
                                </span>

                                <strong>
                                    Low
                                </strong>

                            </div>


                            <div class="rit-priority-item">

                                <div class="rit-priority-dot priority-medium"></div>

                                <span>
                                    Normal business impact
                                </span>

                                <strong>
                                    Medium
                                </strong>

                            </div>


                            <div class="rit-priority-item">

                                <div class="rit-priority-dot priority-high"></div>

                                <span>
                                    Significant disruption
                                </span>

                                <strong>
                                    High
                                </strong>

                            </div>


                            <div class="rit-priority-item">

                                <div class="rit-priority-dot priority-critical"></div>

                                <span>
                                    Critical business impact
                                </span>

                                <strong>
                                    Critical
                                </strong>

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     NOTICE
                     ================================================= -->

                <div class="rit-info-box">

                    <div class="rit-info-box-top">

                        <div class="rit-info-box-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <strong>
                            Helpful information
                        </strong>

                    </div>

                    <p>
                        Include screenshots and exact error messages
                        whenever possible. This can help the support
                        team diagnose the issue more quickly.
                    </p>

                </div>


            </aside>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/CreateTicket.js" asp-append-version="true"></script>
}