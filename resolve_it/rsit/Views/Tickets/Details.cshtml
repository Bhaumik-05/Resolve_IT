@model rsit.Models.Ticket

@{
    ViewData["Title"] = $"Ticket #{Model.TicketId}";

    var statusClass = Model.Status?.ToLowerInvariant()
        .Replace(" ", "-") ?? "unknown";

    var priorityClass = Model.Priority?.ToLowerInvariant()
        .Replace(" ", "-") ?? "unknown";
}

<style>

    /* =========================================================
           RESOLVEIT - TICKET DETAILS
           ========================================================= */

    :root {
        --rit-navy: #14213d;
        --rit-navy-light: #1d3158;
        --rit-blue: #2563eb;
        --rit-blue-dark: #1d4ed8;
        --rit-blue-soft: #eff6ff;
        --rit-blue-border: #bfdbfe;
        --rit-bg: #f3f6fa;
        --rit-surface: #ffffff;
        --rit-text: #172033;
        --rit-text-secondary: #475467;
        --rit-muted: #667085;
        --rit-border: #dfe4ea;
        --rit-border-light: #eaecf0;
        --rit-green: #027a48;
        --rit-green-soft: #ecfdf3;
        --rit-yellow: #b54708;
        --rit-yellow-soft: #fffaeb;
        --rit-orange: #c2410c;
        --rit-orange-soft: #fff7ed;
        --rit-red: #b42318;
        --rit-red-soft: #fef3f2;
        --rit-radius: 11px;
    }


    /* =========================================================
           PAGE
           ========================================================= */

    .rit-details-page {
        min-height: calc(100vh - 120px);
        background: linear-gradient( 180deg, #eef3f9 0, #f5f7fa 220px, #f5f7fa 100% );
        padding: 30px 0 60px;
    }

    .rit-details-container {
        max-width: 1180px;
        margin: 0 auto;
    }


    /* =========================================================
           BREADCRUMB
           ========================================================= */

    .rit-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: var(--rit-muted);
        font-size: 12px;
        font-weight: 500;
    }

        .rit-breadcrumb i {
            font-size: 10px;
            color: #98a2b3;
        }

        .rit-breadcrumb .active {
            color: var(--rit-blue);
            font-weight: 600;
        }


    /* =========================================================
           HEADER
           ========================================================= */

    .rit-ticket-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
        margin-bottom: 22px;
    }

    .rit-ticket-title-area {
        min-width: 0;
    }

    .rit-ticket-number {
        display: inline-flex;
        align-items: center;
        margin-bottom: 8px;
        color: var(--rit-blue);
        font-size: 12px;
        font-weight: 700;
    }

    .rit-ticket-title {
        margin: 0;
        color: var(--rit-navy);
        font-size: 28px;
        line-height: 1.3;
        font-weight: 700;
        letter-spacing: -0.4px;
    }

    .rit-ticket-date {
        margin-top: 7px;
        color: var(--rit-muted);
        font-size: 12px;
    }

    .rit-header-actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

    .rit-header-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 0 14px;
        border: 1px solid #cfd5dd;
        border-radius: 7px;
        background: #ffffff;
        color: #344054;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: background-color .15s ease, border-color .15s ease;
    }

        .rit-header-btn:hover {
            background: #f8fafc;
            color: #172033;
        }


    /* =========================================================
           STATUS BAR
           ========================================================= */

    .rit-status-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 16px;
        margin-bottom: 22px;
        border: 1px solid var(--rit-border);
        border-radius: 9px;
        background: #ffffff;
    }

    .rit-status-label {
        color: var(--rit-muted);
        font-size: 11px;
        font-weight: 600;
    }

    .rit-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .rit-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status-new {
        background: var(--rit-blue-soft);
        color: var(--rit-blue);
    }

        .status-new .rit-status-dot {
            background: var(--rit-blue);
        }

    .status-assigned {
        background: #f0f9ff;
        color: #0369a1;
    }

        .status-assigned .rit-status-dot {
            background: #0284c7;
        }

    .status-in-progress {
        background: var(--rit-yellow-soft);
        color: var(--rit-yellow);
    }

        .status-in-progress .rit-status-dot {
            background: #d97706;
        }

    .status-resolved {
        background: var(--rit-green-soft);
        color: var(--rit-green);
    }

        .status-resolved .rit-status-dot {
            background: #16a34a;
        }

    .status-closed {
        background: #f2f4f7;
        color: #475467;
    }

        .status-closed .rit-status-dot {
            background: #667085;
        }

    .status-reopened {
        background: var(--rit-orange-soft);
        color: var(--rit-orange);
    }

        .status-reopened .rit-status-dot {
            background: #ea580c;
        }


    /* =========================================================
           MAIN GRID
           ========================================================= */

    .rit-details-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 22px;
        align-items: start;
    }


    /* =========================================================
           CARDS
           ========================================================= */

    .rit-card {
        overflow: hidden;
        margin-bottom: 18px;
        border: 1px solid var(--rit-border);
        border-radius: var(--rit-radius);
        background: #ffffff;
        box-shadow: 0 1px 2px rgba(16, 24, 40, .03);
    }

        .rit-card:last-child {
            margin-bottom: 0;
        }

    .rit-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 17px 20px;
        border-bottom: 1px solid var(--rit-border-light);
    }

    .rit-card-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--rit-blue-soft);
        color: var(--rit-blue);
        font-size: 16px;
    }

    .rit-card-heading {
        flex: 1;
    }

        .rit-card-heading h2 {
            margin: 0;
            color: var(--rit-navy);
            font-size: 15px;
            font-weight: 700;
        }

        .rit-card-heading p {
            margin: 3px 0 0;
            color: var(--rit-muted);
            font-size: 11px;
        }

    .rit-card-count {
        color: var(--rit-muted);
        font-size: 11px;
    }

    .rit-card-body {
        padding: 20px;
    }


    /* =========================================================
           DESCRIPTION
           ========================================================= */

    .rit-description {
        color: var(--rit-text-secondary);
        font-size: 13px;
        line-height: 1.75;
        white-space: pre-wrap;
    }


    /* =========================================================
           INFORMATION GRID
           ========================================================= */

    .rit-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .rit-info-item {
        padding-bottom: 14px;
        border-bottom: 1px solid #f0f2f5;
    }

        .rit-info-item:last-child {
            border-bottom: none;
        }

    .rit-info-label {
        margin-bottom: 5px;
        color: var(--rit-muted);
        font-size: 10.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .rit-info-value {
        color: var(--rit-text);
        font-size: 13px;
        font-weight: 600;
    }


    /* =========================================================
           PRIORITY
           ========================================================= */

    .rit-priority {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .rit-priority-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .priority-low {
        color: #15803d;
    }

        .priority-low .rit-priority-dot {
            background: #16a34a;
        }

    .priority-medium {
        color: #a16207;
    }

        .priority-medium .rit-priority-dot {
            background: #eab308;
        }

    .priority-high {
        color: #c2410c;
    }

        .priority-high .rit-priority-dot {
            background: #f97316;
        }

    .priority-critical {
        color: #b91c1c;
    }

        .priority-critical .rit-priority-dot {
            background: #dc2626;
        }


    /* =========================================================
           ATTACHMENTS
           ========================================================= */

    .rit-attachments {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .rit-attachment {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px 14px;
        border: 1px solid #e4e7ec;
        border-radius: 9px;
        background: #ffffff;
        transition: border-color .15s ease, background-color .15s ease;
    }

        .rit-attachment:hover {
            border-color: #bfdbfe;
            background: #f8fbff;
        }

    .rit-attachment-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--rit-blue-soft);
        color: var(--rit-blue);
        font-size: 18px;
    }

    .rit-attachment-info {
        min-width: 0;
        flex: 1;
    }

    .rit-attachment-name {
        overflow: hidden;
        color: var(--rit-text);
        font-size: 12.5px;
        font-weight: 650;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .rit-attachment-meta {
        margin-top: 4px;
        color: var(--rit-muted);
        font-size: 10.8px;
    }

    .rit-attachment-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .rit-attachment-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 7px 10px;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        background: var(--rit-blue-soft);
        color: var(--rit-blue);
        font-size: 10.5px;
        font-weight: 650;
        text-decoration: none;
        white-space: nowrap;
    }

        .rit-attachment-btn:hover {
            border-color: #93c5fd;
            background: #dbeafe;
            color: var(--rit-blue-dark);
        }

    .rit-attachment-download {
        border-color: #d0d5dd;
        background: #ffffff;
        color: #475467;
    }

        .rit-attachment-download:hover {
            border-color: #bfc5ce;
            background: #f8fafc;
            color: #344054;
        }

    .rit-empty {
        padding: 28px 15px;
        color: var(--rit-muted);
        text-align: center;
        font-size: 12px;
    }


    /* =========================================================
           ASSIGNMENTS
           ========================================================= */

    .rit-assignment {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #f0f2f5;
    }

        .rit-assignment:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .rit-assignment-avatar {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #edf2f7;
        color: var(--rit-navy);
        font-size: 13px;
        font-weight: 700;
    }

    .rit-assignment-info {
        flex: 1;
    }

    .rit-assignment-name {
        color: var(--rit-text);
        font-size: 12.5px;
        font-weight: 650;
    }

    .rit-assignment-date {
        margin-top: 3px;
        color: var(--rit-muted);
        font-size: 10.5px;
    }


    /* =========================================================
           HISTORY
           ========================================================= */

    .rit-history {
        position: relative;
    }

    .rit-history-item {
        position: relative;
        display: flex;
        gap: 13px;
        padding-bottom: 22px;
    }

        .rit-history-item:last-child {
            padding-bottom: 0;
        }

    .rit-history-marker {
        position: relative;
        width: 10px;
        flex: 0 0 10px;
    }

        .rit-history-marker::before {
            content: "";
            position: absolute;
            top: 3px;
            left: 1px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--rit-blue);
            box-shadow: 0 0 0 3px var(--rit-blue-soft);
        }

    .rit-history-item:not(:last-child)
    .rit-history-marker::after {
        content: "";
        position: absolute;
        top: 14px;
        left: 4px;
        width: 1px;
        height: calc(100% + 8px);
        background: #dce2ea;
    }

    .rit-history-content {
        flex: 1;
    }

    .rit-history-title {
        color: var(--rit-text);
        font-size: 12px;
        font-weight: 650;
    }

    .rit-history-meta {
        margin-top: 3px;
        color: var(--rit-muted);
        font-size: 10.5px;
    }

    .rit-history-remarks {
        margin-top: 7px;
        padding: 9px 11px;
        border-radius: 6px;
        background: #f8fafc;
        color: var(--rit-text-secondary);
        font-size: 11px;
        line-height: 1.5;
    }


    /* =========================================================
           SIDEBAR
           ========================================================= */

    .rit-sidebar {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .rit-side-card {
        overflow: hidden;
        border: 1px solid var(--rit-border);
        border-radius: var(--rit-radius);
        background: #ffffff;
        box-shadow: 0 1px 2px rgba(16, 24, 40, .03);
    }

    .rit-side-header {
        padding: 15px 17px;
        border-bottom: 1px solid var(--rit-border-light);
    }

        .rit-side-header h3 {
            margin: 0;
            color: var(--rit-navy);
            font-size: 13.5px;
            font-weight: 650;
        }

    .rit-side-body {
        padding: 17px;
    }

    .rit-side-item {
        padding: 11px 0;
        border-bottom: 1px solid #f0f2f5;
    }

        .rit-side-item:first-child {
            padding-top: 0;
        }

        .rit-side-item:last-child {
            padding-bottom: 0;
            border-bottom: none;
        }

    .rit-side-label {
        margin-bottom: 4px;
        color: var(--rit-muted);
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .rit-side-value {
        color: var(--rit-text);
        font-size: 12px;
        font-weight: 600;
    }

    .rit-side-subvalue {
        margin-top: 3px;
        color: var(--rit-muted);
        font-size: 10.5px;
    }


    /* =========================================================
           REQUESTER
           ========================================================= */

    .rit-requester {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .rit-requester-avatar {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--rit-blue-soft);
        color: var(--rit-blue);
        font-size: 13px;
        font-weight: 700;
    }

    .rit-requester-name {
        color: var(--rit-text);
        font-size: 12px;
        font-weight: 650;
    }

    .rit-requester-email {
        margin-top: 3px;
        color: var(--rit-muted);
        font-size: 10.5px;
    }


    /* =========================================================
           FEEDBACK
           ========================================================= */

    .rit-feedback-rating {
        color: #d97706;
        font-size: 16px;
        letter-spacing: 2px;
    }

    .rit-feedback-comment {
        margin-top: 8px;
        color: var(--rit-text-secondary);
        font-size: 12px;
        line-height: 1.6;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 950px) {

        .rit-details-grid {
            grid-template-columns: 1fr;
        }

        .rit-sidebar {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media (max-width: 700px) {

        .rit-details-page {
            padding: 22px 0 35px;
        }

        .rit-ticket-header {
            flex-direction: column;
        }

        .rit-header-actions {
            width: 100%;
        }

        .rit-header-btn {
            flex: 1;
        }

        .rit-ticket-title {
            font-size: 23px;
        }

        .rit-info-grid {
            grid-template-columns: 1fr;
        }

        .rit-sidebar {
            grid-template-columns: 1fr;
        }

        .rit-attachment {
            align-items: flex-start;
        }

        .rit-attachment-actions {
            flex-direction: column;
        }
    }

</style>


<div class="rit-details-page">

    <div class="container rit-details-container">

        <!-- =====================================================
             BREADCRUMB
             ===================================================== -->

        <div class="rit-breadcrumb">

            <span>Helpdesk</span>

            <i class="bi bi-chevron-right"></i>

            <span>Tickets</span>

            <i class="bi bi-chevron-right"></i>

            <span class="active">
                Ticket #@Model.TicketId
            </span>

        </div>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="rit-ticket-header">

            <div class="rit-ticket-title-area">

                <div class="rit-ticket-number">
                    TICKET #@Model.TicketId
                </div>

                <h1 class="rit-ticket-title">
                    @Model.Title
                </h1>

                <div class="rit-ticket-date">
                    Created
                    @Model.CreatedAt.ToLocalTime()
                    .ToString("dd MMM yyyy, hh:mm tt")
                </div>

            </div>


            <div class="rit-header-actions">

                <a asp-action="Create"
                   class="rit-header-btn">

                    <i class="bi bi-plus-lg"></i>

                    New Ticket

                </a>

            </div>

        </div>


        <!-- =====================================================
             STATUS BAR
             ===================================================== -->

        <div class="rit-status-bar">

            <span class="rit-status-label">
                Current status
            </span>

            <span class="rit-status-pill status-@statusClass">

                <span class="rit-status-dot"></span>

                @Model.Status

            </span>

        </div>


        <!-- =====================================================
             MAIN GRID
             ===================================================== -->

        <div class="rit-details-grid">


            <!-- =================================================
                 LEFT CONTENT
                 ================================================= -->

            <main>


                <!-- =================================================
                     DESCRIPTION
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-file-text"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Issue description
                            </h2>

                            <p>
                                Details provided with this support request
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        <div class="rit-description">
                            @Model.Description
                        </div>

                    </div>

                </section>


                <!-- =================================================
                     TICKET INFORMATION
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Ticket information
                            </h2>

                            <p>
                                Classification and ownership details
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        <div class="rit-info-grid">


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Priority
                                </div>

                                <div class="rit-info-value">

                                    <span class="rit-priority priority-@priorityClass">

                                        <span class="rit-priority-dot"></span>

                                        @Model.Priority

                                    </span>

                                </div>

                            </div>


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Category
                                </div>

                                <div class="rit-info-value">
                                    @Model.Category?.Name
                                </div>

                            </div>


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Department
                                </div>

                                <div class="rit-info-value">
                                    @Model.Department?.Name
                                </div>

                            </div>


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Ticket ID
                                </div>

                                <div class="rit-info-value">
                                    #@Model.TicketId
                                </div>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     ATTACHMENTS
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-paperclip"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Attachments
                            </h2>

                            <p>
                                Files submitted with this ticket
                            </p>

                        </div>

                        <span class="rit-card-count">

                            @(Model.Attachments?.Count ?? 0) file(s)

                        </span>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.Attachments != null &&
                             Model.Attachments.Any())
                        {
                            <div class="rit-attachments">

                                @foreach (var attachment in Model.Attachments)
                                {
                                    var extension =
                                        System.IO.Path
                                            .GetExtension(
                                                attachment.FileName)
                                            ?.ToLowerInvariant();

                                    var iconClass =
                                        extension switch
                                        {
                                            ".jpg" or ".jpeg" or ".png"
                                                => "bi-file-earmark-image",

                                            ".pdf"
                                                => "bi-file-earmark-pdf",

                                            ".docx"
                                                => "bi-file-earmark-word",

                                            ".xlsx"
                                                => "bi-file-earmark-excel",

                                            _
                                                => "bi-file-earmark"
                                        };

                                    <div class="rit-attachment">

                                        <div class="rit-attachment-icon">

                                            <i class="bi @iconClass"></i>

                                        </div>


                                        <div class="rit-attachment-info">

                                            <div class="rit-attachment-name"
                                                 title="@attachment.FileName">

                                                @attachment.FileName

                                            </div>

                                            <div class="rit-attachment-meta">

                                                Uploaded
                                                @attachment.UploadedAt
                                                .ToLocalTime()
                                                .ToString(
                                                "dd MMM yyyy, hh:mm tt")

                                                ·

                                                @(Math.Round(
                                                    attachment.FileSize /
                                                    1024.0,
                                                    1))
                                                KB

                                            </div>

                                        </div>


                                        <div class="rit-attachment-actions">

                                            <!-- VIEW -->

                                            <a asp-action="ViewAttachment"
                                               asp-route-id="@attachment.AttachmentId"
                                               target="_blank"
                                               class="rit-attachment-btn">

                                                <i class="bi bi-eye"></i>

                                                View

                                            </a>


                                            <!-- DOWNLOAD -->

                                            <a asp-action="DownloadAttachment"
                                               asp-route-id="@attachment.AttachmentId"
                                               class="rit-attachment-btn rit-attachment-download">

                                                <i class="bi bi-download"></i>

                                                Download

                                            </a>

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="rit-empty">

                                <i class="bi bi-paperclip"></i>

                                <br />

                                No attachments were added
                                to this ticket.

                            </div>
                        }

                    </div>

                </section>


                <!-- =================================================
                     ASSIGNMENTS
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Assignment
                            </h2>

                            <p>
                                Support staff assigned to this ticket
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.Assignments != null &&
                             Model.Assignments.Any())
                        {
                            foreach (var assignment in Model.Assignments)
                            {
                                var staffName =
                                    assignment.Staff?.Name
                                    ?? "Support Staff";

                                var initials =
                                    string.Concat(
                                        staffName
                                            .Split(
                                                ' ',
                                                StringSplitOptions.RemoveEmptyEntries)
                                            .Take(2)
                                            .Select(x =>
                                                char.ToUpper(x[0])));

                                <div class="rit-assignment">

                                    <div class="rit-assignment-avatar">
                                        @initials
                                    </div>

                                    <div class="rit-assignment-info">

                                        <div class="rit-assignment-name">
                                            @staffName
                                        </div>

                                        <div class="rit-assignment-date">

                                            Assigned
                                            @assignment.AssignedAt
                                            .ToLocalTime()
                                            .ToString(
                                            "dd MMM yyyy, hh:mm tt")

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="rit-empty">

                                This ticket has not been assigned
                                to support staff yet.

                            </div>
                        }

                    </div>

                </section>


                <!-- =================================================
                     TICKET ACTIVITY
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Ticket activity
                            </h2>

                            <p>
                                Status changes and ticket history
                            </p>

                        </div>

                        <span class="rit-card-count">

                            @(Model.History?.Count ?? 0) event(s)

                        </span>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.History != null &&
                             Model.History.Any())
                        {
                            <div class="rit-history">

                                @foreach (var history in
                                    Model.History
                                        .OrderByDescending(h => h.ChangedAt))
                                {
                                    <div class="rit-history-item">

                                        <div class="rit-history-marker">
                                        </div>

                                        <div class="rit-history-content">

                                            <div class="rit-history-title">

                                                @history.OldStatus

                                                <i class="bi bi-arrow-right"></i>

                                                @history.NewStatus

                                            </div>

                                            <div class="rit-history-meta">

                                                @history.ChangedAt
                                                .ToLocalTime()
                                                .ToString(
                                                "dd MMM yyyy, hh:mm tt")

                                                @if (history.ChangedByUser != null)
                                                {
                                                    <span>
                                                        ·
                                                        @history.ChangedByUser.Name
                                                    </span>
                                                }

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                history.Remarks))
                                            {
                                                <div class="rit-history-remarks">

                                                    @history.Remarks

                                                </div>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="rit-empty">

                                No status changes have been
                                recorded yet.

                            </div>
                        }

                    </div>

                </section>


                <!-- =================================================
                     FEEDBACK
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-star"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Feedback
                            </h2>

                            <p>
                                Employee feedback for this ticket
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.Feedback != null)
                        {
                            <div class="rit-feedback-rating">

                                @for (var i = 1;
                                      i <= 5;
                                      i++)
                                {
                                    if (i <= Model.Feedback.Rating)
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span>☆</span>
                                    }
                                }

                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                Model.Feedback.Comments))
                            {
                                <div class="rit-feedback-comment">

                                    @Model.Feedback.Comments

                                </div>
                            }
                        }
                        else
                        {
                            <div class="rit-empty">

                                No feedback has been submitted
                                for this ticket yet.

                            </div>
                        }

                    </div>

                </section>

            </main>


            <!-- =================================================
                 RIGHT SIDEBAR
                 ================================================= -->

            <aside class="rit-sidebar">


                <!-- =================================================
                     REQUESTER
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Requester
                        </h3>

                    </div>


                    <div class="rit-side-body">

                        <div class="rit-requester">

                            <div class="rit-requester-avatar">

                                @{
                                    var requesterName =
                                        Model.Employee?.Name
                                        ?? "Employee";

                                    var requesterInitials =
                                        string.Concat(
                                            requesterName
                                                .Split(
                                                    ' ',
                                                    StringSplitOptions.RemoveEmptyEntries)
                                                .Take(2)
                                                .Select(x =>
                                                    char.ToUpper(x[0])));
                                }

                                @requesterInitials

                            </div>


                            <div>

                                <div class="rit-requester-name">
                                    @requesterName
                                </div>

                                <div class="rit-requester-email">

                                    @Model.Employee?.Email

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     TICKET SUMMARY
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Ticket summary
                        </h3>

                    </div>


                    <div class="rit-side-body">


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Ticket number
                            </div>

                            <div class="rit-side-value">
                                #@Model.TicketId
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Status
                            </div>

                            <div class="rit-side-value">
                                @Model.Status
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Priority
                            </div>

                            <div class="rit-side-value">
                                @Model.Priority
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Department
                            </div>

                            <div class="rit-side-value">
                                @Model.Department?.Name
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Category
                            </div>

                            <div class="rit-side-value">
                                @Model.Category?.Name
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     IMPORTANT DATES
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Important dates
                        </h3>

                    </div>


                    <div class="rit-side-body">


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Created
                            </div>

                            <div class="rit-side-value">

                                @Model.CreatedAt
                                .ToLocalTime()
                                .ToString(
                                "dd MMM yyyy")

                            </div>

                            <div class="rit-side-subvalue">

                                @Model.CreatedAt
                                .ToLocalTime()
                                .ToString(
                                "hh:mm tt")

                            </div>

                        </div>


                        @if (Model.ResolvedAt.HasValue)
                        {
                            <div class="rit-side-item">

                                <div class="rit-side-label">
                                    Resolved
                                </div>

                                <div class="rit-side-value">

                                    @Model.ResolvedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "dd MMM yyyy")

                                </div>

                                <div class="rit-side-subvalue">

                                    @Model.ResolvedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "hh:mm tt")

                                </div>

                            </div>
                        }


                        @if (Model.ClosedAt.HasValue)
                        {
                            <div class="rit-side-item">

                                <div class="rit-side-label">
                                    Closed
                                </div>

                                <div class="rit-side-value">

                                    @Model.ClosedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "dd MMM yyyy")

                                </div>

                                <div class="rit-side-subvalue">

                                    @Model.ClosedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "hh:mm tt")

                                </div>

                            </div>
                        }

                    </div>

                </div>


                <!-- =================================================
                     SUPPORT INFORMATION
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Support information
                        </h3>

                    </div>


                    <div class="rit-side-body">

                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Attachment policy
                            </div>

                            <div class="rit-side-value">
                                Optional
                            </div>

                            <div class="rit-side-subvalue">
                                Maximum 5 MB per file
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Supported files
                            </div>

                            <div class="rit-side-value">
                                JPG, PNG, PDF, DOCX, XLSX
                            </div>

                        </div>

                    </div>

                </div>

            </aside>

        </div>

    </div>

</div>