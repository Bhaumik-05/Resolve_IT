@model rsit.Models.Ticket

@{
    ViewData["Title"] = $"Ticket #{Model.TicketId}";

    var statusClass = Model.Status?.ToLowerInvariant()
        .Replace(" ", "-") ?? "unknown";

    var priorityClass = Model.Priority?.ToLowerInvariant()
        .Replace(" ", "-") ?? "unknown";
}

<link rel="stylesheet" href="~/css/TicketDetails.css" asp-append-version="true" />



<div class="rit-details-page">

    <div class="container rit-details-container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- =====================================================
             BREADCRUMB
             ===================================================== -->

        <div class="rit-breadcrumb">

            <span>Helpdesk</span>

            <i class="bi bi-chevron-right"></i>

            <span>Tickets</span>

            <i class="bi bi-chevron-right"></i>

            <span class="active">
                Ticket #@Model.TicketId
            </span>

        </div>


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="rit-ticket-header">

            <div class="rit-ticket-title-area">

                <div class="rit-ticket-number">
                    TICKET #@Model.TicketId
                </div>

                <h1 class="rit-ticket-title">
                    @Model.Title
                </h1>

                <div class="rit-ticket-date">
                    Created
                    @Model.CreatedAt.ToLocalTime()
                    .ToString("dd MMM yyyy, hh:mm tt")
                </div>

            </div>


            <div class="rit-header-actions">

                @if (Model.Status == rsit.Models.TicketStatuses.Resolved)
                {
                    <form asp-action="Close"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to close this ticket?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.TicketId" />

                        <button type="submit"
                                class="rit-header-btn">

                            <i class="bi bi-check2-circle"></i>

                            Close Ticket

                        </button>

                    </form>
                }

                <a asp-action="Create"
                   class="rit-header-btn">

                    <i class="bi bi-plus-lg"></i>

                    New Ticket

                </a>

            </div>

        </div>


        <!-- =====================================================
             STATUS BAR
             ===================================================== -->

        <div class="rit-status-bar">

            <span class="rit-status-label">
                Current status
            </span>

            <span class="rit-status-pill status-@statusClass">

                <span class="rit-status-dot"></span>

                @Model.Status

            </span>

        </div>


        <!-- =====================================================
             MAIN GRID
             ===================================================== -->

        <div class="rit-details-grid">


            <!-- =================================================
                 LEFT CONTENT
                 ================================================= -->

            <main>


                <!-- =================================================
                     DESCRIPTION
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-file-text"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Issue description
                            </h2>

                            <p>
                                Details provided with this support request
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        <div class="rit-description">
                            @Model.Description
                        </div>

                    </div>

                </section>


                <!-- =================================================
                     TICKET INFORMATION
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Ticket information
                            </h2>

                            <p>
                                Classification and ownership details
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        <div class="rit-info-grid">


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Priority
                                </div>

                                <div class="rit-info-value">

                                    <span class="rit-priority priority-@priorityClass">

                                        <span class="rit-priority-dot"></span>

                                        @Model.Priority

                                    </span>

                                </div>

                            </div>


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Category
                                </div>

                                <div class="rit-info-value">
                                    @Model.Category?.Name
                                </div>

                            </div>


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Department
                                </div>

                                <div class="rit-info-value">
                                    @Model.Department?.Name
                                </div>

                            </div>


                            <div class="rit-info-item">

                                <div class="rit-info-label">
                                    Ticket ID
                                </div>

                                <div class="rit-info-value">
                                    #@Model.TicketId
                                </div>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     ATTACHMENTS
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-paperclip"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Attachments
                            </h2>

                            <p>
                                Files submitted with this ticket
                            </p>

                        </div>

                        <span class="rit-card-count">

                            @(Model.Attachments?.Count ?? 0) file(s)

                        </span>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.Attachments != null &&
                             Model.Attachments.Any())
                        {
                            <div class="rit-attachments">

                                @foreach (var attachment in Model.Attachments)
                                {
                                    var extension =
                                        System.IO.Path
                                            .GetExtension(
                                                attachment.FileName)
                                            ?.ToLowerInvariant();

                                    var iconClass =
                                        extension switch
                                        {
                                            ".jpg" or ".jpeg" or ".png"
                                                => "bi-file-earmark-image",

                                            ".pdf"
                                                => "bi-file-earmark-pdf",

                                            ".docx"
                                                => "bi-file-earmark-word",

                                            ".xlsx"
                                                => "bi-file-earmark-excel",

                                            _
                                                => "bi-file-earmark"
                                        };

                                    <div class="rit-attachment">

                                        <div class="rit-attachment-icon">

                                            <i class="bi @iconClass"></i>

                                        </div>


                                        <div class="rit-attachment-info">

                                            <div class="rit-attachment-name"
                                                 title="@attachment.FileName">

                                                @attachment.FileName

                                            </div>

                                            <div class="rit-attachment-meta">

                                                Uploaded
                                                @attachment.UploadedAt
                                                .ToLocalTime()
                                                .ToString(
                                                "dd MMM yyyy, hh:mm tt")

                                                ·

                                                @(Math.Round(
                                                    attachment.FileSize /
                                                    1024.0,
                                                    1))
                                                KB

                                            </div>

                                        </div>


                                        <div class="rit-attachment-actions">

                                            <!-- VIEW -->

                                            <a asp-action="ViewAttachment"
                                               asp-route-id="@attachment.AttachmentId"
                                               target="_blank"
                                               class="rit-attachment-btn">

                                                <i class="bi bi-eye"></i>

                                                View

                                            </a>


                                            <!-- DOWNLOAD -->

                                            <a asp-action="DownloadAttachment"
                                               asp-route-id="@attachment.AttachmentId"
                                               class="rit-attachment-btn rit-attachment-download">

                                                <i class="bi bi-download"></i>

                                                Download

                                            </a>

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="rit-empty">

                                <i class="bi bi-paperclip"></i>

                                <br />

                                No attachments were added
                                to this ticket.

                            </div>
                        }

                    </div>

                </section>


                <!-- =================================================
                     ASSIGNMENTS
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Assignment
                            </h2>

                            <p>
                                Support staff assigned to this ticket
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.Assignments != null &&
                             Model.Assignments.Any())
                        {
                            foreach (var assignment in Model.Assignments)
                            {
                                var staffName =
                                    assignment.Staff?.Name
                                    ?? "Support Staff";

                                var initials =
                                    string.Concat(
                                        staffName
                                            .Split(
                                                ' ',
                                                StringSplitOptions.RemoveEmptyEntries)
                                            .Take(2)
                                            .Select(x =>
                                                char.ToUpper(x[0])));

                                <div class="rit-assignment">

                                    <div class="rit-assignment-avatar">
                                        @initials
                                    </div>

                                    <div class="rit-assignment-info">

                                        <div class="rit-assignment-name">
                                            @staffName
                                        </div>

                                        <div class="rit-assignment-date">

                                            Assigned
                                            @assignment.AssignedAt
                                            .ToLocalTime()
                                            .ToString(
                                            "dd MMM yyyy, hh:mm tt")

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="rit-empty">

                                This ticket has not been assigned
                                to support staff yet.

                            </div>
                        }

                    </div>

                </section>


                <!-- =================================================
                     TICKET ACTIVITY
                     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Ticket activity
                            </h2>

                            <p>
                                Status changes and ticket history
                            </p>

                        </div>

                        <span class="rit-card-count">

                            @(Model.History?.Count ?? 0) event(s)

                        </span>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.History != null &&
                             Model.History.Any())
                        {
                            <div class="rit-history">

                                @foreach (var history in
                                    Model.History
                                        .OrderByDescending(h => h.ChangedAt))
                                {
                                    <div class="rit-history-item">

                                        <div class="rit-history-marker">
                                        </div>

                                        <div class="rit-history-content">

                                            <div class="rit-history-title">

                                                @history.OldStatus

                                                <i class="bi bi-arrow-right"></i>

                                                @history.NewStatus

                                            </div>

                                            <div class="rit-history-meta">

                                                @history.ChangedAt
                                                .ToLocalTime()
                                                .ToString(
                                                "dd MMM yyyy, hh:mm tt")

                                                @if (history.ChangedByUser != null)
                                                {
                                                    <span>
                                                        ·
                                                        @history.ChangedByUser.Name
                                                    </span>
                                                }

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                history.Remarks))
                                            {
                                                <div class="rit-history-remarks">

                                                    @history.Remarks

                                                </div>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="rit-empty">

                                No status changes have been
                                recorded yet.

                            </div>
                        }

                    </div>

                </section>


                <!-- =================================================
     FEEDBACK
     ================================================= -->

                <section class="rit-card">

                    <div class="rit-card-header">

                        <div class="rit-card-icon">

                            <i class="bi bi-star"></i>

                        </div>

                        <div class="rit-card-heading">

                            <h2>
                                Feedback
                            </h2>

                            <p>
                                Your feedback for this support request
                            </p>

                        </div>

                    </div>


                    <div class="rit-card-body">

                        @if (Model.Feedback != null)
                        {
                            <!-- =============================================
                 FEEDBACK ALREADY SUBMITTED
                 ============================================= -->

                            <div class="rit-feedback-rating">

                                @for (var i = 1;
                                      i <= 5;
                                      i++)
                                {
                                    if (i <= Model.Feedback.Rating)
                                    {
                                        <span>★</span>
                                    }
                                    else
                                    {
                                        <span>☆</span>
                                    }
                                }

                            </div>


                            @if (!string.IsNullOrWhiteSpace(
                                Model.Feedback.Comments))
                            {
                                <div class="rit-feedback-comment">

                                    @Model.Feedback.Comments

                                </div>
                            }


                            <div class="text-muted small mt-2">

                                Submitted
                                @Model.Feedback.SubmittedAt
                                .ToLocalTime()
                                .ToString(
                                "dd MMM yyyy, hh:mm tt")

                            </div>
                        }
                        else if (
                            Model.Status ==
                                rsit.Models.TicketStatuses.Resolved ||
                            Model.Status ==
                                rsit.Models.TicketStatuses.Closed)
                        {
                            <!-- =============================================
                 SUBMIT FEEDBACK
                 ============================================= -->

                            <form asp-action="SubmitFeedback"
                                  method="post">

                                @Html.AntiForgeryToken()


                                <input type="hidden"
                                       name="ticketId"
                                       value="@Model.TicketId" />


                                <!-- RATING -->

                                <div class="mb-3">

                                    <label for="rating"
                                           class="form-label">

                                        Rating

                                    </label>


                                    <select id="rating"
                                            name="rating"
                                            class="form-select"
                                            required>

                                        <option value="">
                                            Select a rating
                                        </option>

                                        <option value="5">
                                            5 - Excellent
                                        </option>

                                        <option value="4">
                                            4 - Good
                                        </option>

                                        <option value="3">
                                            3 - Average
                                        </option>

                                        <option value="2">
                                            2 - Poor
                                        </option>

                                        <option value="1">
                                            1 - Very poor
                                        </option>

                                    </select>

                                </div>


                                <!-- COMMENTS -->

                                <div class="mb-3">

                                    <label for="comments"
                                           class="form-label">

                                        Comments

                                        <span class="text-muted">
                                            (optional)
                                        </span>

                                    </label>


                                    <textarea id="comments"
                                              name="comments"
                                              class="form-control"
                                              rows="4"
                                              maxlength="1000"
                                              placeholder="Tell us about your support experience..."></textarea>

                                </div>


                                <!-- SUBMIT -->

                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-star me-1"></i>

                                    Submit Feedback

                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="rit-empty">

                                Feedback can be submitted after
                                the ticket is resolved.

                            </div>
                        }

                    </div>

                </section>

            </main>


            <!-- =================================================
                 RIGHT SIDEBAR
                 ================================================= -->

            <aside class="rit-sidebar">


                <!-- =================================================
                     REQUESTER
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Requester
                        </h3>

                    </div>


                    <div class="rit-side-body">

                        <div class="rit-requester">

                            <div class="rit-requester-avatar">

                                @{
                                    var requesterName =
                                        Model.Employee?.Name
                                        ?? "Employee";

                                    var requesterInitials =
                                        string.Concat(
                                            requesterName
                                                .Split(
                                                    ' ',
                                                    StringSplitOptions.RemoveEmptyEntries)
                                                .Take(2)
                                                .Select(x =>
                                                    char.ToUpper(x[0])));
                                }

                                @requesterInitials

                            </div>


                            <div>

                                <div class="rit-requester-name">
                                    @requesterName
                                </div>

                                <div class="rit-requester-email">

                                    @Model.Employee?.Email

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     TICKET SUMMARY
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Ticket summary
                        </h3>

                    </div>


                    <div class="rit-side-body">


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Ticket number
                            </div>

                            <div class="rit-side-value">
                                #@Model.TicketId
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Status
                            </div>

                            <div class="rit-side-value">
                                @Model.Status
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Priority
                            </div>

                            <div class="rit-side-value">
                                @Model.Priority
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Department
                            </div>

                            <div class="rit-side-value">
                                @Model.Department?.Name
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Category
                            </div>

                            <div class="rit-side-value">
                                @Model.Category?.Name
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     IMPORTANT DATES
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Important dates
                        </h3>

                    </div>


                    <div class="rit-side-body">


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Created
                            </div>

                            <div class="rit-side-value">

                                @Model.CreatedAt
                                .ToLocalTime()
                                .ToString(
                                "dd MMM yyyy")

                            </div>

                            <div class="rit-side-subvalue">

                                @Model.CreatedAt
                                .ToLocalTime()
                                .ToString(
                                "hh:mm tt")

                            </div>

                        </div>


                        @if (Model.ResolvedAt.HasValue)
                        {
                            <div class="rit-side-item">

                                <div class="rit-side-label">
                                    Resolved
                                </div>

                                <div class="rit-side-value">

                                    @Model.ResolvedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "dd MMM yyyy")

                                </div>

                                <div class="rit-side-subvalue">

                                    @Model.ResolvedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "hh:mm tt")

                                </div>

                            </div>
                        }


                        @if (Model.ClosedAt.HasValue)
                        {
                            <div class="rit-side-item">

                                <div class="rit-side-label">
                                    Closed
                                </div>

                                <div class="rit-side-value">

                                    @Model.ClosedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "dd MMM yyyy")

                                </div>

                                <div class="rit-side-subvalue">

                                    @Model.ClosedAt.Value
                                    .ToLocalTime()
                                    .ToString(
                                    "hh:mm tt")

                                </div>

                            </div>
                        }

                    </div>

                </div>


                <!-- =================================================
                     SUPPORT INFORMATION
                     ================================================= -->

                <div class="rit-side-card">

                    <div class="rit-side-header">

                        <h3>
                            Support information
                        </h3>

                    </div>


                    <div class="rit-side-body">

                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Attachment policy
                            </div>

                            <div class="rit-side-value">
                                Optional
                            </div>

                            <div class="rit-side-subvalue">
                                Maximum 5 MB per file
                            </div>

                        </div>


                        <div class="rit-side-item">

                            <div class="rit-side-label">
                                Supported files
                            </div>

                            <div class="rit-side-value">
                                JPG, PNG, PDF, DOCX, XLSX
                            </div>

                        </div>

                    </div>

                </div>

            </aside>

        </div>

    </div>

</div>