@{
    Layout = null;

    int statusCode = ViewBag.StatusCode ?? 500;

    string title = ViewBag.Title ?? "Something Went Wrong";

    string message = ViewBag.Message
        ?? "An unexpected error occurred while processing your request.";

    string statusText = statusCode switch
    {
        400 => "Bad Request",
        401 => "Authentication Required",
        403 => "Access Restricted",
        404 => "Page Not Found",
        405 => "Method Not Allowed",
        500 => "Internal Server Error",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        _ => "Unexpected Error"
    };
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@statusCode - @title | ResolveIT</title>


    <style>

            /* =====================================================
                       RESET
                    ===================================================== */

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }


            html,
            body {
                min-height: 100%;
            }


            /* =====================================================
                       BODY
                    ===================================================== */

            body {
                font-family: "Segoe UI", Arial, sans-serif;
                background: #f4f8fb;
                color: #243447;
                overflow-x: hidden;
            }


            /* =====================================================
                       ANIMATED BACKGROUND
                    ===================================================== */

            .background {
                position: fixed;
                inset: 0;
                overflow: hidden;
                pointer-events: none;
                z-index: 0;
            }


            .circle {
                position: absolute;
                border-radius: 50%;
                filter: blur(2px);
                opacity: 0.45;
                animation: float 10s ease-in-out infinite;
            }


            .circle-one {
                width: 320px;
                height: 320px;
                background: rgba(25, 118, 210, 0.12);
                top: -100px;
                left: -80px;
            }


            .circle-two {
                width: 420px;
                height: 420px;
                background: rgba(0, 150, 136, 0.10);
                bottom: -160px;
                right: -120px;
                animation-delay: -4s;
            }


            .circle-three {
                width: 180px;
                height: 180px;
                background: rgba(25, 118, 210, 0.08);
                top: 45%;
                right: 8%;
                animation-delay: -7s;
            }


            @@keyframes float {

                0%,
                100% {
                    transform: translateY(0px) translateX(0px);
                }

                50% {
                    transform: translateY(-25px) translateX(15px);
                }
            }


            /* =====================================================
                       PAGE
                    ===================================================== */

            .page {
                position: relative;
                z-index: 1;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 20px;
            }


            /* =====================================================
                       ERROR CARD
                    ===================================================== */

            .error-card {
                width: 100%;
                max-width: 950px;
                background: rgba(255, 255, 255, 0.94);
                border: 1px solid rgba(255, 255, 255, 0.8);
                border-radius: 20px;
                padding: 55px;
                box-shadow: 0 20px 60px rgba(30, 70, 100, 0.10), 0 5px 20px rgba(30, 70, 100, 0.05);
                backdrop-filter: blur(12px);
                animation: cardAppear 0.7s ease-out;
            }


            @@keyframes cardAppear {

                from {
                    opacity: 0;
                    transform: translateY(25px) scale(0.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }


            /* =====================================================
                       HEADER
                    ===================================================== */

            .header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 45px;
            }


            .logo {
                display: flex;
                align-items: center;
                gap: 11px;
                text-decoration: none;
            }


            .logo-icon {
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                background: linear-gradient( 135deg, #1976d2, #00897b );
                color: white;
                font-size: 18px;
                font-weight: 700;
                box-shadow: 0 6px 15px rgba(25, 118, 210, 0.20);
            }


            .logo-text {
                font-size: 22px;
                font-weight: 700;
                letter-spacing: -0.5px;
                color: #263b50;
            }


                .logo-text span {
                    color: #1976d2;
                }


            .support-badge {
                display: flex;
                align-items: center;
                gap: 7px;
                padding: 8px 13px;
                background: #f1f8f7;
                border: 1px solid #d8eeea;
                border-radius: 20px;
                color: #43877e;
                font-size: 12px;
                font-weight: 600;
            }


            .status-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #26a69a;
                animation: pulse 2s infinite;
            }


            @@keyframes pulse {

                0% {
                    box-shadow: 0 0 0 0 rgba(38, 166, 154, 0.35);
                }

                70% {
                    box-shadow: 0 0 0 7px rgba(38, 166, 154, 0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(38, 166, 154, 0);
                }
            }


            /* =====================================================
                       CONTENT
                    ===================================================== */

            .content {
                display: grid;
                grid-template-columns: 0.9fr 1.1fr;
                gap: 65px;
                align-items: center;
            }


            /* =====================================================
                       STATUS CODE
                    ===================================================== */

            .code-section {
                text-align: center;
                position: relative;
            }


            .code-label {
                display: inline-block;
                padding: 7px 13px;
                border-radius: 20px;
                background: #eef5fb;
                color: #1976d2;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                margin-bottom: 15px;
            }


            .status-code {
                font-size: clamp(110px, 15vw, 170px);
                line-height: 0.9;
                font-weight: 800;
                letter-spacing: -8px;
                background: linear-gradient( 135deg, #1976d2, #00897b );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
                animation: codeFloat 4s ease-in-out infinite;
            }


            @@keyframes codeFloat {

                0%,
                100% {
                    transform: translateY(0);
                }

                50% {
                    transform: translateY(-8px);
                }
            }


            .code-line {
                width: 70px;
                height: 4px;
                margin: 18px auto 0;
                border-radius: 5px;
                background: linear-gradient( 90deg, #1976d2, #26a69a );
            }


            /* =====================================================
                       MESSAGE
                    ===================================================== */

            .message-section {
                padding-right: 10px;
            }


                .message-section h1 {
                    font-size: 34px;
                    line-height: 1.2;
                    color: #263b50;
                    margin-bottom: 15px;
                    font-weight: 700;
                }


                    .message-section h1::after {
                        content: "";
                        display: block;
                        width: 45px;
                        height: 3px;
                        margin-top: 14px;
                        border-radius: 3px;
                        background: linear-gradient( 90deg, #1976d2, #26a69a );
                    }


            .description {
                color: #718096;
                font-size: 15px;
                line-height: 1.8;
                margin-bottom: 25px;
                max-width: 550px;
            }


            /* =====================================================
                       INFORMATION BOX
                    ===================================================== */

            .info-box {
                background: #f7fafc;
                border: 1px solid #e7eef4;
                border-radius: 12px;
                padding: 17px 20px;
                margin-bottom: 27px;
            }


            .info-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 8px 0;
            }


                .info-row + .info-row {
                    border-top: 1px solid #e9eff4;
                }


            .info-label {
                color: #8a99a8;
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }


            .info-value {
                color: #40566c;
                font-size: 13px;
                font-weight: 600;
            }


            .status-value {
                display: flex;
                align-items: center;
                gap: 7px;
                color: #328f84;
            }


                .status-value .mini-dot {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: #26a69a;
                }


            /* =====================================================
                       BUTTONS
                    ===================================================== */

            .actions {
                display: flex;
                gap: 12px;
                flex-wrap: wrap;
            }


            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 12px 21px;
                border-radius: 8px;
                font-size: 13px;
                font-weight: 600;
                text-decoration: none;
                border: none;
                cursor: pointer;
                transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            }


            .btn-primary {
                color: white;
                background: linear-gradient( 135deg, #1976d2, #2388d4 );
                box-shadow: 0 6px 15px rgba(25, 118, 210, 0.18);
            }


                .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 9px 20px rgba(25, 118, 210, 0.25);
                }


            .btn-secondary {
                color: #506579;
                background: white;
                border: 1px solid #dce6ed;
            }


                .btn-secondary:hover {
                    transform: translateY(-2px);
                    background: #f7fafc;
                    border-color: #cbd8e2;
                }


            /* =====================================================
                       FOOTER
                    ===================================================== */

            .footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 50px;
                padding-top: 20px;
                border-top: 1px solid #e8eef3;
                color: #9aa8b5;
                font-size: 11px;
            }


            .footer-right {
                color: #6da59d;
            }


            /* =====================================================
                       RESPONSIVE
                    ===================================================== */

            @@media (max-width: 750px) {

                .error-card {
                    padding: 35px 25px;
                    border-radius: 16px;
                }


                .header {
                    margin-bottom: 30px;
                }


                .support-badge {
                    display: none;
                }


                .content {
                    grid-template-columns: 1fr;
                    gap: 35px;
                }


                .status-code {
                    font-size: 110px;
                }


                .message-section {
                    text-align: center;
                    padding: 0;
                }


                    .message-section h1 {
                        font-size: 28px;
                    }


                        .message-section h1::after {
                            margin-left: auto;
                            margin-right: auto;
                        }


                .description {
                    margin-left: auto;
                    margin-right: auto;
                }


                .actions {
                    justify-content: center;
                }


                .footer {
                    flex-direction: column;
                    gap: 8px;
                    text-align: center;
                }
            }


            @@media (max-width: 450px) {

                .logo-text {
                    font-size: 19px;
                }


                .logo-icon {
                    width: 34px;
                    height: 34px;
                }


                .status-code {
                    font-size: 90px;
                    letter-spacing: -5px;
                }


                .message-section h1 {
                    font-size: 24px;
                }


                .btn {
                    width: 100%;
                }
            }

    </style>

</head>


<body>


    <!-- Animated Background -->

    <div class="background">

        <div class="circle circle-one"></div>

        <div class="circle circle-two"></div>

        <div class="circle circle-three"></div>

    </div>


    <!-- Page -->

    <main class="page">


        <!-- Error Card -->

        <section class="error-card">


            <!-- Header -->

            <header class="header">


                <a href="/" class="logo">

                    <div class="logo-icon">

                        R

                    </div>


                    <div class="logo-text">

                        Resolve<span>IT</span>

                    </div>

                </a>


                <div class="support-badge">

                    <span class="status-dot"></span>

                    System Operational

                </div>


            </header>


            <!-- Main Content -->

            <div class="content">


                <!-- Status Code -->

                <div class="code-section">

                    <div class="code-label">

                        ERROR CODE

                    </div>


                    <div class="status-code">

                        @statusCode

                    </div>


                    <div class="code-line"></div>

                </div>


                <!-- Message -->

                <div class="message-section">


                    <h1>

                        @title

                    </h1>


                    <p class="description">

                        @message

                    </p>


                    <!-- Information -->

                    <div class="info-box">


                        <div class="info-row">

                            <span class="info-label">

                                Status Code

                            </span>

                            <span class="info-value">

                                @statusCode

                            </span>

                        </div>


                        <div class="info-row">

                            <span class="info-label">

                                Status

                            </span>

                            <span class="info-value">

                                @statusText

                            </span>

                        </div>


                        <div class="info-row">

                            <span class="info-label">

                                Service

                            </span>

                            <span class="info-value">

                                ResolveIT

                            </span>

                        </div>


                        <div class="info-row">

                            <span class="info-label">

                                System

                            </span>

                            <span class="info-value status-value">

                                <span class="mini-dot"></span>

                                Operational

                            </span>

                        </div>


                    </div>


                    <!-- Actions -->

                    <div class="actions">


                        <a href="/"
                           class="btn btn-primary">

                            ← Back to Home

                        </a>


                        <button type="button"
                                onclick="history.back()"
                                class="btn btn-secondary">

                            Go Back

                        </button>


                    </div>


                </div>

            </div>


            <!-- Footer -->

            <footer class="footer">

                <span>

                    ResolveIT Complaint Management System

                </span>


                <span class="footer-right">

                    Need assistance? Contact Support

                </span>

            </footer>


        </section>

    </main>


</body>

</html>