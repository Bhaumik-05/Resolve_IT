@model UserListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";

    Dictionary<string, string?> PageRoute(int page) => new()
    {
        ["search"] = Model.Search,
        ["departmentId"] = Model.DepartmentId?.ToString(),
        ["role"] = Model.Role,
        ["status"] = Model.Status,
        ["page"] = page.ToString()
    };

    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search) || Model.DepartmentId.HasValue
        || !string.IsNullOrWhiteSpace(Model.Role) || !string.IsNullOrWhiteSpace(Model.Status);
}

<div class="page-header">
    <div>
        <h1>Users</h1>
        <p>@Model.TotalCount registered @(Model.TotalCount == 1 ? "user" : "users")@(hasFilters ? " match the filters" : "")</p>
    </div>
    <a class="btn btn-teal" asp-action="Create"><i class="bi bi-person-plus me-1"></i> Add User</a>
</div>

<div class="card-panel">

    <form method="get" asp-action="Index" class="filter-bar">
        <input type="search" name="search" value="@Model.Search" class="form-control search-box"
               placeholder="Search name, email or employee ID" />

        <select name="departmentId" class="form-select">
            <option value="">All departments</option>
            @foreach (var d in Model.Departments)
            {
                <option value="@d.Value" selected="@(d.Value == Model.DepartmentId?.ToString())">@d.Text</option>
            }
        </select>

        <select name="role" class="form-select">
            <option value="">All roles</option>
            @foreach (var r in UserRoles.All)
            {
                <option value="@r" selected="@(r == Model.Role)">@UserRoles.DisplayName(r)</option>
            }
        </select>

        <select name="status" class="form-select">
            <option value="">Any status</option>
            <option value="Active" selected="@(Model.Status == "Active")">Active</option>
            <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
        </select>

        <button type="submit" class="btn btn-teal"><i class="bi bi-search me-1"></i> Filter</button>
        @if (hasFilters)
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        }
    </form>

    @if (Model.Users.Count == 0)
    {
        <div class="empty-note">No users found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover admin-table">
                <thead>
                    <tr>
                        <th>Employee ID</th><th>Name</th><th>Email</th><th>Department</th>
                        <th>Role</th><th>Status</th><th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var active = u.AccountStatus == "Active";
                        <tr>
                            <td><code>@u.EmployeeId</code></td>
                            <td>
                                @u.Name
                                @if (u.IsCurrentUser)
                                {
                                    <span class="badge text-bg-light border ms-1">You</span>
                                }
                            </td>
                            <td>@u.Email</td>
                            <td>@u.Department</td>
                            <td><span class="pill pill-role">@UserRoles.DisplayName(u.Role)</span></td>
                            <td><span class="pill @(active ? "pill-active" : "pill-inactive")">@u.AccountStatus</span></td>
                            <td>
                                <div class="table-actions">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@u.Id">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    @if (!u.IsCurrentUser)
                                    {
                                        <form asp-action="SetStatus" asp-route-id="@u.Id" method="post"
                                              onsubmit="return confirm('@(active ? "Deactivate" : "Activate") this user?');">
                                            <input type="hidden" name="activate" value="@((!active).ToString().ToLower())" />
                                            <button type="submit" class="btn btn-sm @(active ? "btn-outline-danger" : "btn-outline-success")">
                                                @(active ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Users pages">
                <ul class="pagination pagination-sm mb-0 justify-content-end">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Page - 1)">Previous</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(p)">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="PageRoute(Model.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
