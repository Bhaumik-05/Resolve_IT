@model UserFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit User";
}

<div class="page-header">
    <div>
        <h1>Edit User</h1>
        <p>Employee ID <span class="readonly-chip">@Model.EmployeeId</span></p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-1"></i> Back to users</a>
</div>

<div class="card-panel form-card mb-4">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>

        <partial name="_UserFields" model="Model" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-teal"><i class="bi bi-check2 me-1"></i> Save Changes</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>

    </form>
</div>

<div class="card-panel form-card">
    <h2>Reset password</h2>
    <p class="text-muted small">Sets a new password for this user and clears any failed-login lockout.</p>

    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post"
          onsubmit="return confirm('Reset the password for this user?');">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="NewPassword">New password</label>
                <input id="NewPassword" name="NewPassword" type="password" class="form-control" autocomplete="new-password" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="ConfirmPassword">Confirm password</label>
                <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" required />
            </div>
        </div>
        <div class="form-text mb-3">At least 8 characters with upper- and lower-case letters, a digit and a special character.</div>
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-key me-1"></i> Reset Password</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
