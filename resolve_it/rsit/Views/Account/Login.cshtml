@model rsit.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ResolveIT - Login</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body>

    <div class="auth-wrapper">

        <div class="auth-container">

            <!-- LEFT SIDE -->
            <div class="auth-brand">

                <div class="brand-icon">
                    <i class="bi bi-headset"></i>
                </div>

                <h1>ResolveIT</h1>

                <p>
                    Campus IT Complaint &amp; Support Management System
                </p>

                <div class="brand-features">

                    <div>
                        <i class="bi bi-ticket-detailed"></i>
                        <span>Raise and track complaints</span>
                    </div>

                    <div>
                        <i class="bi bi-people"></i>
                        <span>Connect with support staff</span>
                    </div>

                    <div>
                        <i class="bi bi-graph-up"></i>
                        <span>Monitor resolution progress</span>
                    </div>

                </div>

            </div>


            <!-- RIGHT SIDE -->
            <div class="auth-form-container">

                <div class="auth-form">

                    <div class="mobile-brand">
                        <div class="brand-icon">
                            <i class="bi bi-headset"></i>
                        </div>

                        <h2>ResolveIT</h2>
                    </div>

                    <h2>Welcome Back</h2>

                    <p class="auth-subtitle">
                        Sign in to continue to your account
                    </p>


                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                        </div>
                    }


                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <form asp-action="Login"
                          asp-controller="Account"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- EMAIL -->

                        <div class="form-group">

                            <label asp-for="Email">
                                Email Address
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-envelope"></i>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter your email" />

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <label asp-for="Password">
                                Password
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-lock"></i>

                                <input asp-for="Password"
                                       class="form-control"
                                       placeholder="Enter your password" />

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- REMEMBER -->

                        <div class="login-options">

                            <label class="remember-me">

                                <input asp-for="RememberMe" />

                                <span>
                                    Remember me
                                </span>

                            </label>

                        </div>


                        <button type="submit"
                                class="btn-login">

                            <span>Sign In</span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>


                    <div class="auth-divider">
                        <span>New to ResolveIT?</span>
                    </div>


                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn-register">

                        Create an Account

                    </a>

                </div>

            </div>

        </div>

    </div>


    <partial name="_ValidationScriptsPartial" />

</body>
</html>