@model rsit.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ResolveIT - Register</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body>

    <div class="auth-wrapper">

        <div class="auth-container register-container">

            <!-- LEFT SIDE -->

            <div class="auth-brand">

                <div class="brand-icon">
                    <i class="bi bi-headset"></i>
                </div>

                <h1>ResolveIT</h1>

                <p>
                    Campus IT Complaint &amp; Support Management System
                </p>

                <div class="brand-features">

                    <div>
                        <i class="bi bi-person-plus"></i>
                        <span>Create your employee account</span>
                    </div>

                    <div>
                        <i class="bi bi-ticket-detailed"></i>
                        <span>Raise and track complaints</span>
                    </div>

                    <div>
                        <i class="bi bi-headset"></i>
                        <span>Get support from IT staff</span>
                    </div>

                </div>

            </div>


            <!-- RIGHT SIDE -->

            <div class="auth-form-container register-form-container">

                <div class="auth-form register-form">

                    <!-- MOBILE BRAND -->

                    <div class="mobile-brand">

                        <div class="brand-icon">
                            <i class="bi bi-headset"></i>
                        </div>

                        <h2>ResolveIT</h2>

                    </div>


                    <h2>Create Account</h2>

                    <p class="auth-subtitle">
                        Register as an employee to get started
                    </p>


                    <!-- GENERAL ERRORS -->

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <form asp-action="Register"
                          asp-controller="Account"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- NAME + EMPLOYEE ID -->

                        <div class="register-row">

                            <div class="form-group">

                                <label asp-for="Name">
                                    Employee Name
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-person"></i>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Enter your name" />

                                </div>

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="form-group">

                                <label asp-for="EmployeeId">
                                    Employee ID
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-person-badge"></i>

                                    <input asp-for="EmployeeId"
                                           class="form-control"
                                           placeholder="Enter employee ID" />

                                </div>

                                <span asp-validation-for="EmployeeId"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- EMAIL + MOBILE -->

                        <div class="register-row">

                            <div class="form-group">

                                <label asp-for="Email">
                                    Email Address
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-envelope"></i>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="Enter your email" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="form-group">

                                <label asp-for="Mobile">
                                    Mobile Number
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-phone"></i>

                                    <input asp-for="Mobile"
                                           class="form-control"
                                           placeholder="Enter mobile number" />

                                </div>

                                <span asp-validation-for="Mobile"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- DEPARTMENT -->

                        <div class="form-group">

                            <label asp-for="DepartmentId">
                                Department
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-building"></i>

                                <select asp-for="DepartmentId"
                                        class="form-control">

                                    <option value="">Select Department</option>

                                    @foreach (var department in Model.Departments)
                                    {
                                        <option value="@department.DepartmentId">
                                            @department.Name
                                        </option>
                                    }

                                </select>

                            </div>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PASSWORD + CONFIRM PASSWORD -->

                        <div class="register-row">

                            <div class="form-group">

                                <label asp-for="Password">
                                    Password
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-lock"></i>

                                    <input asp-for="Password"
                                           class="form-control"
                                           placeholder="Create a password" />

                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="form-group">

                                <label asp-for="ConfirmPassword">
                                    Confirm Password
                                </label>

                                <div class="input-wrapper">

                                    <i class="bi bi-shield-lock"></i>

                                    <input asp-for="ConfirmPassword"
                                           class="form-control"
                                           placeholder="Confirm your password" />

                                </div>

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- REGISTER BUTTON -->

                        <button type="submit"
                                class="btn-login register-button">

                            <span>Create Account</span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>


                    <!-- LOGIN -->

                    <div class="auth-divider">
                        <span>Already have an account?</span>
                    </div>


                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn-register">

                        Sign In

                    </a>

                </div>

            </div>

        </div>

    </div>


    <partial name="_ValidationScriptsPartial" />

</body>
</html>